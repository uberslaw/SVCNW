<UserControl x:Class="ServiceNowDesk.Controls.ChoiceFilterBox"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <Style x:Key="ChoiceFilterButton" TargetType="Button">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxHeight" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChoiceFilterItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Bd" Property="Background" Value="#D7EFEB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Bd" Property="Background" Value="#D7EFEB"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid MinHeight="28" MaxHeight="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="24"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="OpenButton"
                Style="{StaticResource ChoiceFilterButton}"
                Click="Open_Click"
                ToolTip="Shows how many choices are selected. Click to open the list. Ctrl+click selects more than one."
                AutomationProperties.Name="{Binding FilterName, ElementName=Root}">
            <DockPanel LastChildFill="True">
                <Path DockPanel.Dock="Right"
                      Data="M 0 0 L 3.5 3.5 L 7 0"
                      Stroke="{StaticResource MutedBrush}"
                      StrokeThickness="1.3"
                      Width="8"
                      Height="4"
                      Stretch="Fill"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      IsHitTestVisible="False"/>
                <TextBlock Text="{Binding ClosedLabel, ElementName=Root}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Button>
        <Popup x:Name="ChoicePopup"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=OpenButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="Drop_Closed">
            <Border x:Name="DropBorder"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    MaxHeight="420"
                    SnapsToDevicePixels="True">
                <Grid>
                    <TextBlock x:Name="EmptyHint"
                               Text="No values"
                               Margin="8,6"
                               Foreground="{StaticResource MutedBrush}"
                               Visibility="Collapsed"/>
                    <ListBox x:Name="ChoiceList"
                             SelectionMode="Extended"
                             BorderThickness="0"
                             Background="{StaticResource CardBrush}"
                             ItemContainerStyle="{StaticResource ChoiceFilterItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             MaxHeight="420"
                             SelectionChanged="ChoiceList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
        <Button Grid.Column="2"
                Style="{StaticResource ChoiceFilterButton}"
                Width="24"
                Padding="0"
                HorizontalContentAlignment="Center"
                Click="Clear_Click"
                ToolTip="Clear filters"
                AutomationProperties.Name="{Binding ClearName, ElementName=Root}"
                Content="&#x00D7;"
                FontSize="14"/>
    </Grid>
</UserControl>
