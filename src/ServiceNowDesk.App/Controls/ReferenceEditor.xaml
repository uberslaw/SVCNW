<UserControl x:Class="ServiceNowDesk.Controls.ReferenceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <TextBox x:Name="Input"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="Input_PreviewKeyDown"
                 SizeChanged="Input_SizeChanged"/>
        <Popup x:Name="SuggestionPopup"
               PlacementTarget="{Binding ElementName=Input}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               IsOpen="{Binding HasSuggestions, Mode=OneWay}">
            <Border x:Name="SuggestionBorder"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    MaxHeight="240"
                    MinWidth="220">
                <ListBox x:Name="SuggestionList"
                         ItemsSource="{Binding Suggestions}"
                         SelectedIndex="{Binding HighlightedIndex}"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource DeskListItem}"
                         PreviewMouseLeftButtonUp="SuggestionList_Click"
                         PreviewKeyDown="SuggestionList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,1">
                                <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
