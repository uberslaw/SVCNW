<UserControl x:Class="ServiceNowDesk.Controls.ListActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServiceNowDesk.Controls">
    <StackPanel Margin="0,0,0,8">
        <controls:EqualButtonGrid x:Name="Buttons" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding ListRefreshedText}"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="11"
                   Margin="0,8,0,0"
                   Visibility="{Binding ListRefreshedText, Converter={StaticResource StringVis}}"/>
    </StackPanel>
</UserControl>
