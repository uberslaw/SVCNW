<UserControl x:Class="ServiceNowDesk.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="8">
            <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

            <TextBlock Text="Notifications" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8"
                    DataContext="{Binding NotificationSettings}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                               Text="The desktop strip at the top center of the screen drops the notification bar when the pointer rests on it, and when a jiggle fires. The portion that caused a jiggle is highlighted. The watched group and office locations decide the group queue."/>

                    <TextBlock Text="When the desktop widget appears" Style="{StaticResource FieldLabel}"/>
                    <RadioButton GroupName="ShowDesktopWidget" Margin="0,0,0,4"
                                 Content="While the desk is open, including maximized"
                                 IsChecked="{Binding ShowDesktopWidget, Converter={StaticResource EnumEq}, ConverterParameter=WhileOpen}"/>
                    <RadioButton GroupName="ShowDesktopWidget" Margin="0,0,0,12"
                                 Content="Only while the desk is minimized"
                                 IsChecked="{Binding ShowDesktopWidget, Converter={StaticResource EnumEq}, ConverterParameter=OnlyMinimized}"/>

                    <TextBlock Text="When a jiggle fires" Style="{StaticResource FieldLabel}"/>
                    <RadioButton GroupName="JiggleWhen" Margin="0,0,0,4"
                                 Content="Persistent, every HH:MM:SS"
                                 IsChecked="{Binding JiggleWhen, Converter={StaticResource EnumEq}, ConverterParameter=Persistent}"/>
                    <RadioButton GroupName="JiggleWhen" Margin="0,0,0,12"
                                 IsChecked="{Binding JiggleWhen, Converter={StaticResource EnumEq}, ConverterParameter=NewUntilAcknowledged}">
                        <TextBlock Text="Only when there is a new alert, until that alert is acknowledged" TextWrapping="Wrap"/>
                    </RadioButton>

                    <TextBlock Text="Jiggle frequency (HH:MM:SS)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"
                               Text="Persistent mode drops the bar on this frequency while something is still unacknowledged. A new alert ignores this interval and does not repeat until that alert is acknowledged."/>

                    <TextBlock Text="Jiggle duration (seconds)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <CheckBox Content="Maximize when jiggling" IsChecked="{Binding MaximizeWhenJiggling}" Margin="0,0,0,8"/>
                    <CheckBox Content="Play sound when jiggling" IsChecked="{Binding PlaySoundWhenJiggling}" Margin="0,0,0,8"/>
                    <CheckBox Content="Play sound on alert metric" IsChecked="{Binding PlaySoundOnAlertMetric}" Margin="0,0,0,10"/>

                    <TextBlock Text="Sound (.wav)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseSound_Click"/>
                        <TextBox Text="{Binding SoundPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" ToolTip="Leave this empty to use the Windows exclamation sound."/>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                               Text="Play sound when jiggling plays when the bar drops for a jiggle. Play sound on alert metric plays as soon as a number increases, even when the jiggle sound is off. Both use this file, or the Windows exclamation sound when no file is chosen."/>

                    <TextBlock Text="Watched group name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding GroupNameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Office locations (one city per line)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding LocationsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,10"/>

                    <TextBlock Text="Check ServiceNow every (seconds)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding PollSecondsText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                    <Button Content="Save notification settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}"/>
                    <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding SettingsMessage, Converter={StaticResource StringVis}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Cache" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14"
                       Text="Each row is a copy saved on this PC. Refresh clears that copy and downloads it again. Incident templates and the saved sign-in stay where they are."/>

            <Button Content="Refresh all" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,14"
                    Command="{Binding RefreshAllCachesCommand}"
                    AutomationProperties.Name="Refresh all caches"
                    IsEnabled="{Binding Startup.IsRunning, Converter={StaticResource InverseBool}}"/>

            <ItemsControl ItemsSource="{Binding Caches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                                <Button Grid.Column="1" Width="36" Height="32" Padding="0" Cursor="Hand"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.RefreshCacheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        ToolTip="Refresh"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Refresh {0}}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" HorizontalAlignment="Center"/>
                                </Button>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
