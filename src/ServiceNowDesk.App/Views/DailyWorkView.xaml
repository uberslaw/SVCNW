<UserControl x:Class="ServiceNowDesk.Views.DailyWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ServiceNowDesk.ViewModels;assembly=ServiceNowDesk.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Margin="8">
            <TextBlock Text="Daily Work" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                       Text="{x:Static vm:DailyWorkViewModel.IntroText}"/>

            <TextBlock Text="New unassigned in the group queue" FontWeight="SemiBold" Margin="0,0,0,4"
                       Visibility="{Binding HasNewUnassigned, Converter={StaticResource BoolVis}}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Text="These opened unassigned since the first look today. A priority 1 or 2 is marked. They stay here even when they are not yet on the attend list."
                       Visibility="{Binding HasNewUnassigned, Converter={StaticResource BoolVis}}"/>
            <Grid Margin="10,0,10,4" Visibility="{Binding HasNewUnassigned, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Number" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1" Text="Priority" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="2" Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="3" Text="Group" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="4" Text="Office" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="5" Text="Opened" Style="{StaticResource FieldLabel}"/>
            </Grid>
            <ListBox ItemsSource="{Binding NewUnassigned}"
                     Style="{StaticResource DeskList}"
                     MaxHeight="220"
                     MouseLeftButtonUp="NewUnassigned_MouseLeftButtonUp"
                     PreviewKeyDown="NewUnassigned_PreviewKeyDown"
                     AutomationProperties.Name="New unassigned in the group queue"
                     Visibility="{Binding HasNewUnassigned, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource TicketListItem}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Not part of my queue" Click="NotPartOfMyQueue_Click" Tag="new-unassigned"
                                              AutomationProperties.Name="Not part of my queue"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PriorityBadge}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PriorityBadge}" Value="P1">
                                                    <Setter Property="Foreground" Value="#B42318"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PriorityBadge}" Value="P2">
                                                    <Setter Property="Foreground" Value="#B54708"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding PriorityText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EmphasizePriority}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding Group}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Margin="8,0" Text="{Binding Office}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding When}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton GroupName="DailyWorkArea" Content="My work" Margin="0,0,18,0"
                             IsChecked="{Binding Area, Converter={StaticResource EnumEq}, ConverterParameter=Mine}"
                             AutomationProperties.Name="My work"/>
                <RadioButton GroupName="DailyWorkArea" Content="My team"
                             IsChecked="{Binding Area, Converter={StaticResource EnumEq}, ConverterParameter=Team}"
                             AutomationProperties.Name="My team daily work"/>
            </StackPanel>

            <WrapPanel Margin="0,0,0,12" AutomationProperties.Name="Daily work color key">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <Border Width="28" Height="14" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Background="{Binding ActFirstHex, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="Red, act first" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <Border Width="28" Height="14" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Background="{Binding NextHex, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="Yellow, next" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="28" Height="14" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Background="{Binding AfterThoseHex, Converter={StaticResource HexBrush}}"/>
                    <TextBlock Text="Green, after those" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock Text="{Binding TeamPrompt}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                       Visibility="{Binding TeamPrompt, Converter={StaticResource StringVis}}"/>

            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="No tickets in these queues need attention." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Visibility="{Binding HasAttend, Converter={StaticResource InverseBoolVis}}"/>

            <Grid Margin="10,0,10,4" Visibility="{Binding HasAttend, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <Button Content="{Binding ColourHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Colour" AutomationProperties.Name="Sort by colour"/>
                <Button Grid.Column="1" Content="{Binding NumberHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Number" AutomationProperties.Name="Sort by number"/>
                <Button Grid.Column="2" Content="{Binding PriorityHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Priority" AutomationProperties.Name="Sort by priority"/>
                <Button Grid.Column="3" Content="{Binding TitleHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Title" AutomationProperties.Name="Sort by title"/>
                <Button Grid.Column="4" Content="{Binding WhyHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Why" AutomationProperties.Name="Sort by why"/>
                <Button Grid.Column="5" Content="{Binding StateHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="State" AutomationProperties.Name="Sort by state"/>
                <Button Grid.Column="6" Content="{Binding OfficeHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Office" AutomationProperties.Name="Sort by office"/>
                <Button Grid.Column="7" Content="{Binding AssigneeHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Assignee" AutomationProperties.Name="Sort by assigned to"/>
            </Grid>
            <ListBox ItemsSource="{Binding Attend}"
                     Style="{StaticResource DeskList}"
                     MaxHeight="420"
                     MouseLeftButtonUp="Attend_MouseLeftButtonUp"
                     PreviewKeyDown="Attend_PreviewKeyDown"
                     AutomationProperties.Name="Daily work list"
                     Visibility="{Binding HasAttend, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource TicketListItem}">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Not part of my queue" Click="NotPartOfMyQueue_Click" Tag="attend"
                                              AutomationProperties.Name="Not part of my queue"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="12" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    Background="{Binding HighlightHex, Converter={StaticResource HexBrush}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding PriorityText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Margin="8,0" Text="{Binding Reasons}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Margin="8,0" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Margin="8,0" Text="{Binding Office}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{Binding AssigneeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding ReportNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Visibility="{Binding ReportNote, Converter={StaticResource StringVis}}"/>
            <TextBlock Text="{Binding DifferenceNote}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,8"
                       Visibility="{Binding DifferenceNote, Converter={StaticResource StringVis}}"/>

            <TextBlock Text="No longer on today's report" FontWeight="SemiBold" Margin="0,0,0,4"
                       Visibility="{Binding HasCleared, Converter={StaticResource BoolVis}}"/>
            <Grid Margin="10,0,10,4" Visibility="{Binding HasCleared, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="{Binding NumberHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Number" AutomationProperties.Name="Sort cleared by number"/>
                <Button Grid.Column="1" Content="{Binding TitleHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Title" AutomationProperties.Name="Sort cleared by title"/>
            </Grid>
            <ListBox ItemsSource="{Binding Cleared}"
                     Style="{StaticResource DeskList}"
                     ItemContainerStyle="{StaticResource TicketListItem}"
                     MaxHeight="220"
                     MouseLeftButtonUp="Cleared_MouseLeftButtonUp"
                     PreviewKeyDown="Cleared_PreviewKeyDown"
                     AutomationProperties.Name="No longer on today's report"
                     Visibility="{Binding HasCleared, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="New since today's report" FontWeight="SemiBold" Margin="0,0,0,4"
                       Visibility="{Binding HasArrived, Converter={StaticResource BoolVis}}"/>
            <Grid Margin="10,0,10,4" Visibility="{Binding HasArrived, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <Button Content="{Binding ColourHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Colour" AutomationProperties.Name="Sort arrived by colour"/>
                <Button Grid.Column="1" Content="{Binding NumberHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Number" AutomationProperties.Name="Sort arrived by number"/>
                <Button Grid.Column="2" Content="{Binding PriorityHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Priority" AutomationProperties.Name="Sort arrived by priority"/>
                <Button Grid.Column="3" Content="{Binding TitleHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Title" AutomationProperties.Name="Sort arrived by title"/>
                <Button Grid.Column="4" Content="{Binding WhyHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                        Command="{Binding SortByCommand}" CommandParameter="Why" AutomationProperties.Name="Sort arrived by why"/>
            </Grid>
            <ListBox ItemsSource="{Binding Arrived}"
                     Style="{StaticResource DeskList}"
                     ItemContainerStyle="{StaticResource TicketListItem}"
                     MaxHeight="220"
                     MouseLeftButtonUp="Arrived_MouseLeftButtonUp"
                     PreviewKeyDown="Arrived_PreviewKeyDown"
                     AutomationProperties.Name="New since the report"
                     Visibility="{Binding HasArrived, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="210"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="12" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    Background="{Binding HighlightHex, Converter={StaticResource HexBrush}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding PriorityText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Margin="8,0" Text="{Binding Reasons}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Margin="0,8,0,4" Visibility="{Binding HasDismissed, Converter={StaticResource BoolVis}}">
                <Button DockPanel.Dock="Right" Content="Clear dismissals" Style="{StaticResource SecondaryButton}" Padding="10,4" MinHeight="28"
                        Command="{Binding ClearDismissalsCommand}" AutomationProperties.Name="Clear dismissals"/>
                <TextBlock Text="Not part of my queue today" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Text="These stay off Daily Work for the rest of the local day. Clear them here, or they drop out after midnight."
                       Visibility="{Binding HasDismissed, Converter={StaticResource BoolVis}}"/>
            <ListBox ItemsSource="{Binding Dismissed}"
                     Style="{StaticResource DeskList}"
                     ItemContainerStyle="{StaticResource TicketListItem}"
                     MaxHeight="160"
                     AutomationProperties.Name="Dismissed from my queue"
                     Visibility="{Binding HasDismissed, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Office}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding Reason}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding When}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="My notes" FontWeight="SemiBold" Margin="0,18,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Text="These stay on this PC for the current Windows user. They are not ServiceNow records until you choose Incident or RITM."/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="500"
                         VerticalAlignment="Center"
                         ToolTip="Note"
                         AutomationProperties.Name="Note text"
                         PreviewKeyDown="NoteText_PreviewKeyDown"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0">
                    <RadioButton GroupName="PersonalNoteLight" Style="{StaticResource TrafficChoice}" Background="#C0392B" ToolTip="Red"
                                 AutomationProperties.Name="Red"
                                 IsChecked="{Binding NoteLight, Converter={StaticResource EnumEq}, ConverterParameter=Red}"/>
                    <RadioButton GroupName="PersonalNoteLight" Style="{StaticResource TrafficChoice}" Background="#E6A317" ToolTip="Amber"
                                 AutomationProperties.Name="Amber"
                                 IsChecked="{Binding NoteLight, Converter={StaticResource EnumEq}, ConverterParameter=Amber}"/>
                    <RadioButton GroupName="PersonalNoteLight" Style="{StaticResource TrafficChoice}" Background="#2E9B4F" ToolTip="Green"
                                 AutomationProperties.Name="Green"
                                 IsChecked="{Binding NoteLight, Converter={StaticResource EnumEq}, ConverterParameter=Green}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        Command="{Binding AddNoteCommand}" AutomationProperties.Name="Add note"/>
            </Grid>

            <TextBlock Text="No notes yet." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Visibility="{Binding HasNotes, Converter={StaticResource InverseBoolVis}}"/>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource CardBrush}"
                    Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding Notes}" AutomationProperties.Name="My notes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEF2F4" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Left"
                                             Fill="{Binding LightHex, Converter={StaticResource HexBrush}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Incident" Style="{StaticResource SecondaryButton}" Padding="10,4" MinHeight="28" Margin="0,0,6,0"
                                                Command="{Binding DataContext.CreateIncidentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="Create incident"/>
                                        <Button Content="RITM" Style="{StaticResource SecondaryButton}" Padding="10,4" MinHeight="28" Margin="0,0,6,0"
                                                Command="{Binding DataContext.CreateRequestedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="Create requested item"/>
                                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Padding="10,4" MinHeight="28"
                                                Command="{Binding DataContext.RemoveNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="Remove note"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
