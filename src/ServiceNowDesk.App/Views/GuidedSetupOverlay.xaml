<UserControl x:Class="ServiceNowDesk.Views.GuidedSetupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="True"
             Visibility="{Binding Guided.ShowChrome, Converter={StaticResource BoolVis}}">
    <Grid>
        <Path x:Name="DimPath" Fill="#FF000000" Opacity="0" IsHitTestVisible="False"/>

        <Canvas x:Name="TourLayer" IsHitTestVisible="True">
            <Border x:Name="PulseRing" Visibility="Collapsed" IsHitTestVisible="False"
                    BorderBrush="#F4FFFC" BorderThickness="3" CornerRadius="6" Background="Transparent"/>
            <Border x:Name="InstructionChip" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#F0102226" BorderBrush="#9FE0D8" BorderThickness="1" CornerRadius="10" Padding="16,12" MaxWidth="640">
                <StackPanel>
                    <TextBlock x:Name="InstructionText" Text="{Binding Guided.InstructionText}"
                               Foreground="#F7FFFC" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="30"/>
                    <TextBlock Text="{Binding Guided.FailureText}" Margin="0,10,0,0"
                               Foreground="#FFD2D2" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding Guided.FailureText, Converter={StaticResource StringVis}}"/>
                </StackPanel>
            </Border>
            <Border x:Name="TabChip" Visibility="Collapsed" Background="#F0102226" BorderBrush="#9FE0D8"
                    BorderThickness="1" CornerRadius="10" Padding="16,12" MaxWidth="440">
                <StackPanel>
                    <TextBlock Text="{Binding Guided.TabLine}" Foreground="#F7FFFC" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" LineHeight="30" IsHitTestVisible="False"/>
                    <Button Content="Next" Command="{Binding Guided.NextCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            MinWidth="88" Padding="16,8" Cursor="Hand" AutomationProperties.Name="Next tab">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#102226"/>
                                <Setter Property="Background" Value="#F7FFFC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#D6F4EF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="96,24,96,0" MaxWidth="760" Padding="18,14"
                Background="#F0102226" BorderBrush="#9FE0D8" BorderThickness="1" CornerRadius="10" IsHitTestVisible="False"
                Visibility="{Binding Guided.BannerText, Converter={StaticResource StringVis}}">
            <TextBlock Text="{Binding Guided.BannerText}" Foreground="#F7FFFC" FontSize="22" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="30"/>
        </Border>

        <Button Content="Exit" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" MinWidth="88" Padding="16,8"
                Command="{Binding Guided.ExitCommand}" Cursor="Hand" Panel.ZIndex="5"
                AutomationProperties.Name="Exit guided setup"
                Visibility="{Binding Guided.ShowTour, Converter={StaticResource BoolVis}}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#F7FFFC"/>
                    <Setter Property="Background" Value="#145E5B"/>
                    <Setter Property="BorderBrush" Value="#9FE0D8"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1F7A76"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <Grid Visibility="{Binding Guided.ShowOffer, Converter={StaticResource BoolVis}}">
            <Border Background="#99000000"/>
            <Border Width="560" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="24,22">
                <StackPanel>
                    <TextBlock Text="{Binding Guided.OfferTitle}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Guided.OfferBody}" Margin="0,8,0,18" FontSize="16" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Yes" Command="{Binding Guided.YesCommand}" Style="{StaticResource PrimaryButton}" MinWidth="88" Margin="0,0,8,0"/>
                        <Button Content="Not this time" Command="{Binding Guided.NotThisTimeCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="Don't ask again" Command="{Binding Guided.DontAskAgainCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
