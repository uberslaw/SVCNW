<Window x:Class="ServiceNowDesk.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help"
        Width="760"
        Height="680"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="HelpBody" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="HelpHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="HelpCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="HelpBullet" TargetType="TextBlock" BasedOn="{StaticResource HelpBody}">
            <Setter Property="Margin" Value="8,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Authentication Setup" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource HelpBody}" Margin="0,0,0,14"
                           Text="One OAuth application in ServiceNow covers every desk user. Each person still signs in as themselves, and ServiceNow applies that person's roles and groups."/>

                <Border Style="{StaticResource HelpCard}">
                    <StackPanel>
                        <TextBlock Text="What you create once" Style="{StaticResource HelpHeading}"/>
                        <TextBlock Style="{StaticResource HelpBody}" Margin="0"
                                   Text="In ServiceNow, go to System OAuth &gt; Application Registry. Create one &quot;OAuth API endpoint for external clients&quot;. That gives one client ID and one client secret. Every copy of ServiceNow Desk uses that same pair. People do not each need their own OAuth application, and you do not create one registry record per person."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCard}">
                    <StackPanel>
                        <TextBlock Text="What each person enters" Style="{StaticResource HelpHeading}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="On Connection, leave practice data off. Choose OAuth password grant and enter:"/>
                        <TextBlock Style="{StaticResource HelpBullet}" Text="•  The instance URL, for example https://company.service-now.com"/>
                        <TextBlock Style="{StaticResource HelpBullet}" Text="•  The shared client ID and client secret"/>
                        <TextBlock Style="{StaticResource HelpBullet}" Margin="8,0,0,10" Text="•  Their own ServiceNow user name and password"/>
                        <TextBlock Style="{StaticResource HelpBody}" Text="Click Connect."/>
                        <TextBlock Style="{StaticResource HelpBody}" Margin="0"
                                   Text="The app posts those to https://&lt;instance&gt;/oauth_token.do using the password grant. ServiceNow returns a token for that user. Ticket calls then run as that user, so ACLs, assignment groups, and My open / My groups match the web UI for the person at the keyboard. The password and client secret stay on that PC, encrypted with Windows DPAPI for the current Windows user, under %AppData%\ServiceNowDesk\settings.json. When the token expires, the app requests a new one with the same saved user name and password. There is no shared login session between machines."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCard}">
                    <StackPanel>
                        <TextBlock Text="What not to use for agents" Style="{StaticResource HelpHeading}"/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="OAuth client credentials is one integration account. On the registry record, set OAuth Application User to that account. Every API call then runs as that account. My open is that account, not the person at the keyboard. Use client credentials only for an unattended integration, not for the desk."/>
                        <TextBlock Style="{StaticResource HelpBody}"
                                   Text="Username and password (no OAuth) is also per person: each agent enters their own ServiceNow user name and password, and calls run as that user. Use it when the instance still allows basic authentication for the API."/>
                        <TextBlock Style="{StaticResource HelpBody}" Margin="0"
                                   Text="People only need the ServiceNow accounts they already have. Each app talks directly to the same instance URL."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HelpCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Table access" Style="{StaticResource HelpHeading}"/>
                        <TextBlock Style="{StaticResource HelpBody}" Margin="0"
                                   Text="The signed-in user needs read and write on incident, sc_request, and sc_req_item. They also need read on sys_user, sys_user_group, sys_choice, and sys_journal_field. If they use Order catalog, they need catalog order rights."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
