<Window x:Class="ServiceNowDesk.Views.AlertWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServiceNow Desk notifications"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="Manual"
        Width="280"
        Height="4"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <!-- Soft light-yellow jiggle highlight: ~2 pulses/sec, forever while IsJiggleCause stays true. -->
        <SolidColorBrush x:Key="JigglePulseBrush" Color="#FFF3C4"/>
        <Style x:Key="JigglePulseOverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource JigglePulseBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsJiggleCause}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.28"
                                                 To="0.72"
                                                 Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickupJigglePulseOverlayStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource JigglePulseBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPickupJiggleCause}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.28"
                                                 To="0.72"
                                                 Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="WidgetRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource LineBrush}">
        <ItemsControl ItemsSource="{Binding Circles}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border Background="{Binding Kind, Converter={StaticResource AlertBrush}}"/>
                        <Border Style="{StaticResource JigglePulseOverlayStyle}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Border>
        <Button x:Name="PickupSlaBar"
                Grid.Row="1"
                Height="10"
                Padding="0"
                BorderThickness="0"
                Cursor="Hand"
                Focusable="False"
                Click="PickupSla_Click"
                ToolTip="{Binding PickupToolTip}"
                AutomationProperties.Name="{Binding PickupLabel}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1A1A1A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding PickupBarPercent}"
                                                     Height="10"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="{StaticResource SlaBrush}"
                                                     IsHitTestVisible="False"/>
                                        <ItemsControl ItemsSource="{Binding PickupTicks}" IsHitTestVisible="False" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="10"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#66FFFFFF" BorderThickness="0,0,1,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource PickupJigglePulseOverlayStyle}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPickupSla}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Border x:Name="DropPanel" Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="0,0,8,8" Padding="10,8" MinHeight="36">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Circles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,0" Cursor="Hand" Focusable="False" Padding="4,2"
                                    Click="Circle_Click"
                                    AutomationProperties.Name="{Binding StatusLabel}"
                                    ToolTip="{Binding ToolTipText}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border CornerRadius="6" Style="{StaticResource JigglePulseOverlayStyle}"/>
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="28" Height="28" Margin="0,0,8,0">
                                                        <Ellipse IsHitTestVisible="False"
                                                                 Fill="{Binding Kind, Converter={StaticResource AlertBrush}}"/>
                                                        <TextBlock Text="{Binding Count}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,6,0,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SlaBrush}"
                           Text="{Binding PickupLabel}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPickupSla}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
