<UserControl x:Class="ServiceNowDesk.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox Content="Incidents" IsChecked="{Binding IncludeIncidents}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Requests" IsChecked="{Binding IncludeRequests}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Request items" IsChecked="{Binding IncludeItems}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Walk-up" IsChecked="{Binding IncludeWalkUps}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Knowledge" IsChecked="{Binding IncludeKnowledge}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6"/>
            <TextBlock Text="Loading…" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}"/>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" Text="Double-click a row, or press Enter, to open it. Back on the record returns to this list."/>
        <ListBox x:Name="Results"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding Selected}"
                 Style="{StaticResource DeskList}"
                 ItemContainerStyle="{StaticResource TicketListItem}"
                 MouseDoubleClick="Results_MouseDoubleClick"
                 PreviewKeyDown="Results_PreviewKeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding TableLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StateLabel}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding When}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
