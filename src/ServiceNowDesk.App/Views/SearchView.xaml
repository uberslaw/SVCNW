<UserControl x:Class="ServiceNowDesk.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServiceNowDesk.Controls">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <CheckBox Content="Incidents" IsChecked="{Binding IncludeIncidents}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Requests" IsChecked="{Binding IncludeRequests}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Request items" IsChecked="{Binding IncludeItems}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Walk-up" IsChecked="{Binding IncludeWalkUps}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox Content="Knowledge" IsChecked="{Binding IncludeKnowledge}" Margin="0,0,16,6" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,6" TextWrapping="Wrap"/>
            <TextBlock Text="Loading…" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" ToolTip="Leave a box empty to skip that filter. + requires every term. * is a wildcard. Quotes are optional.">
            <TextBlock Text="Group" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,6"/>
            <controls:ReferenceEditor DataContext="{Binding AssignmentGroup}" Width="200" Margin="0,0,14,6" ToolTip="Assignment group. Empty means any group."/>
            <TextBlock Text="Assignee" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,6"/>
            <controls:ReferenceEditor DataContext="{Binding Assignee}" Width="200" Margin="0,0,14,6" ToolTip="Assignee. Empty means anyone."/>
            <TextBlock Text="Opened" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,6"/>
            <DatePicker SelectedDate="{Binding OpenedFrom}" Width="130" Margin="0,0,6,6" ToolTip="Opened on or after"/>
            <TextBlock Text="to" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,6"/>
            <DatePicker SelectedDate="{Binding OpenedTo}" Width="130" Margin="0,0,14,6" ToolTip="Opened on or before"/>
            <TextBlock Text="State" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,6"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Width="220" Height="88" Margin="0,0,8,6"
                    ToolTip="Ctrl+click to select multiple states. Empty selection shows all states.">
                <ListBox x:Name="StateFilter"
                         ItemsSource="{Binding StateOptions}"
                         SelectionMode="Extended"
                         IsSynchronizedWithCurrentItem="False"
                         BorderThickness="0"
                         Background="{StaticResource CardBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="StateFilter_SelectionChanged"
                         AutomationProperties.Name="State filter"/>
            </Border>
            <StackPanel Margin="0,0,0,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateFilterSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <Button Content="Clear states" Style="{StaticResource QuietButton}" Padding="6,2" MinHeight="24"
                        Click="ClearStates_Click" ToolTip="Clear state selection (show all)"
                        AutomationProperties.Name="Clear state filter"/>
            </StackPanel>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding FilterMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding FilterMessage, Converter={StaticResource StringVis}}"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Clear grouping" Style="{StaticResource QuietButton}" Padding="6,2" MinHeight="24"
                    Command="{Binding ClearGroupingCommand}"
                    Visibility="{Binding HasGrouping, Converter={StaticResource BoolVis}}"
                    AutomationProperties.Name="Clear grouping"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Double-click a row, or press Enter, to open it. Click a column header to sort. Right-click a header to group by that column. Back on the record returns to this list."/>
        </DockPanel>
        <DataGrid x:Name="Results"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding Selected}"
                  Style="{StaticResource DeskDataGrid}"
                  ColumnHeaderStyle="{StaticResource DeskDataGridColumnHeader}"
                  CellStyle="{StaticResource DeskDataGridCell}"
                  RowStyle="{StaticResource SearchDataGridRow}"
                  ColumnHeaderHeight="28"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="Results_MouseDoubleClick"
                  PreviewKeyDown="Results_PreviewKeyDown"
                  AutomationProperties.Name="Search results">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource AccentSoftBrush}" Padding="8,4" Margin="0,0,0,2">
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                    <Run Text="  ("/>
                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding TableLabel}" Width="100" MinWidth="80"
                                    ElementStyle="{StaticResource DeskDataGridText}" SortMemberPath="TableLabel"/>
                <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="110" MinWidth="90"
                                    ElementStyle="{StaticResource DeskDataGridAccentText}" SortMemberPath="Number"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" MinWidth="140"
                                    ElementStyle="{StaticResource DeskDataGridText}" SortMemberPath="Title"/>
                <DataGridTextColumn Header="Meta" Binding="{Binding Meta}" Width="*" MinWidth="100"
                                    ElementStyle="{StaticResource DeskDataGridText}" SortMemberPath="Meta"/>
                <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="120" MinWidth="90"
                                    ElementStyle="{StaticResource DeskDataGridText}" SortMemberPath="StateLabel"/>
                <DataGridTextColumn Header="Updated" Binding="{Binding When}" Width="130" MinWidth="100"
                                    ElementStyle="{StaticResource DeskDataGridText}" SortMemberPath="When"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
