<UserControl x:Class="ServiceNowDesk.Views.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KnowledgeLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   TextDecorations="Underline"
                                   TextWrapping="Wrap"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="{Binding PublishedCountText}"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"
                   Visibility="{Binding PublishedCountText, Converter={StaticResource StringVis}}"/>

        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBox DockPanel.Dock="Top"
                     Margin="0,0,0,8"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter the saved articles by number, title, or description"
                     AutomationProperties.Name="Filter knowledge articles"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding ListCaption}" Foreground="{StaticResource MutedBrush}" Visibility="{Binding ListCaption, Converter={StaticResource StringVis}}"/>
                <TextBlock Text="  Loading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ListNote}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ListNote, Converter={StaticResource StringVis}}"/>
            <ListBox ItemsSource="{Binding Articles}"
                     SelectedItem="{Binding SelectedArticle}"
                     Style="{StaticResource DeskList}"
                     ItemContainerStyle="{StaticResource DeskListItem}"
                     AutomationProperties.Name="Knowledge articles">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                    <Border Margin="8,0,0,0" CornerRadius="8" Padding="6,1" Background="#EEF3F4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateLabel}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/>
                                <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,8,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid Grid.Row="1" Grid.Column="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolVis}}">
                <TextBlock Text="No article open" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="Select an article from the list. The filter looks through the articles saved on this PC."
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"/>
            </StackPanel>

            <DockPanel Visibility="{Binding HasArticle, Converter={StaticResource BoolVis}}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="28,24" MaxWidth="860" HorizontalAlignment="Left">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Copy number" Style="{StaticResource SecondaryButton}" Command="{Binding CopyNumberCommand}" Margin="0,0,8,8" AutomationProperties.Name="Copy number"/>
                                <Button Content="Open in browser" Style="{StaticResource SecondaryButton}" Command="{Binding OpenInBrowserCommand}" Margin="0,0,8,8" AutomationProperties.Name="Open in browser"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ReaderMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding ReaderMessage, Converter={StaticResource StringVis}}"/>
                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,8"/>
                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <ItemsControl ItemsSource="{Binding Blocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Text}"
                                                       FontSize="15"
                                                       TextWrapping="Wrap"
                                                       LineHeight="24"
                                                       Visibility="{Binding IsLink, Converter={StaticResource InverseBoolVis}}"/>
                                            <Button Content="{Binding Text}"
                                                    Style="{StaticResource KnowledgeLinkButton}"
                                                    Command="{Binding DataContext.OpenArticleLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Url}"
                                                    ToolTip="{Binding Url}"
                                                    Visibility="{Binding IsLink, Converter={StaticResource BoolVis}}"
                                                    AutomationProperties.Name="{Binding Text}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
