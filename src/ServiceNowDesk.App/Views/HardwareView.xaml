<UserControl x:Class="ServiceNowDesk.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServiceNowDesk.Controls">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Receive laptops" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Choose one stockroom for the batch. Type a serial or let the scanner type it, then press Enter. That adds the exact text as a row and clears this box. Look up, press Enter on the row, or leave the field to match that text. Extra characters in front of 5C are only a hint." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Stockroom" Style="{StaticResource FieldLabel}"/>
                        <controls:ReferenceEditor DataContext="{Binding ReceiveStockroom}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Serial" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False"
                                 PreviewKeyDown="ScanBox_PreviewKeyDown"
                                 AutomationProperties.Name="Scan serial"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ReceiveMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ReceiveMessage, Converter={StaticResource StringVis}}"/>
                <TextBlock Text="Batch" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="{Binding HasBatch, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding Batch}" Visibility="{Binding HasBatch, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="False"
                                                 LostFocus="RowSerial_LostFocus"
                                                 PreviewKeyDown="RowSerial_PreviewKeyDown"
                                                 AutomationProperties.Name="Scanned serial"/>
                                        <Button Grid.Column="2" Content="Look up" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.LookupRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource CustomerBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasHint, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding MatchedSerial, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding OldState, Mode=OneWay}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding NewState, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Offices" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding AccountOfficeText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="The list starts at the office on the signed-in account and filters the computers saved on this PC. Checkboxes change the filter without downloading again. Refresh this office or Refresh all downloads in the background. Override office remembers the checked offices on this PC. Clear override returns to your office. All locations shows every saved computer." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding OfficeSearchText, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="28" Padding="6,4" Margin="0,0,0,6"
                             AutomationProperties.Name="Find office"/>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MaxHeight="168" Margin="0,0,0,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleOffices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="8,3"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Office {0}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding OfficeSelectionSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="All locations" Style="{StaticResource SecondaryButton}" Command="{Binding SearchAllLocationsCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Override office" Style="{StaticResource SecondaryButton}" Command="{Binding OverrideOfficeCommand}" Margin="0,0,8,0"/>
                        <Button Content="Clear override" Style="{StaticResource SecondaryButton}" Command="{Binding ClearOverrideCommand}" Margin="0,0,8,0"/>
                        <Button Content="Refresh this office" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshOfficeCatalogCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Refresh all" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAllCatalogCommand}"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OfficeStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding OfficeStatus, Converter={StaticResource StringVis}}"/>
                    <TextBlock Text="{Binding CatalogStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding CatalogStatus, Converter={StaticResource StringVis}}"/>
                    <Grid Margin="0,0,0,6" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" Height="16"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                   Text="{Binding DownloadPercent, StringFormat={}{0}%}"/>
                    </Grid>
                </StackPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Text="{Binding Items.Count, StringFormat={}{0} shown}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="  Loading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="  Downloading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"/>
                    <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="SearchTipsButton"
                                Content="Search tips"
                                Style="{StaticResource QuietButton}"
                                Padding="6,2"
                                MinHeight="24"
                                Command="{Binding ShowSearchTipsCommand}"
                                ToolTip="Wildcard and filter rules"
                                AutomationProperties.Name="Search tips"/>
                        <Popup IsOpen="{Binding SearchTipsOpen, Mode=TwoWay}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=SearchTipsButton}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    Padding="14"
                                    MaxWidth="420"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="{Binding SearchTipsTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SearchTipsBody}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                    <Button Content="Close"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0"
                                            Command="{Binding CloseSearchTipsCommand}"
                                            AutomationProperties.Name="Close search tips"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" MinWidth="64" SharedSizeGroup="HwSerial"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwAssigned"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwLocation"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="90" MinWidth="64" SharedSizeGroup="HwState"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwSubstate"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="140" MinWidth="72" SharedSizeGroup="HwComments"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Serial" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <TextBlock Grid.Column="2" Text="Model" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <TextBlock Grid.Column="4" Text="Assigned to" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <GridSplitter Grid.Column="5" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <TextBlock Grid.Column="6" Text="Location" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <GridSplitter Grid.Column="7" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <TextBlock Grid.Column="8" Text="State" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <GridSplitter Grid.Column="9" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <TextBlock Grid.Column="10" Text="Substate" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <GridSplitter Grid.Column="11" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
                        <TextBlock Grid.Column="12" Text="Comments" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" MinWidth="64" SharedSizeGroup="HwSerial"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwAssigned"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwLocation"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="90" MinWidth="64" SharedSizeGroup="HwState"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwSubstate"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="140" MinWidth="72" SharedSizeGroup="HwComments"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SerialFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="6,4" AutomationProperties.Name="Filter serial"/>
                        <TextBox Grid.Column="2" Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="6,4" AutomationProperties.Name="Filter model"/>
                        <TextBox Grid.Column="4" Text="{Binding AssignedFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="6,4" AutomationProperties.Name="Filter assigned to"/>
                        <TextBox Grid.Column="6" Text="{Binding LocationFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="6,4" AutomationProperties.Name="Filter location"/>
                        <TextBox Grid.Column="8" Text="{Binding StateFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="6,4" AutomationProperties.Name="Filter state"/>
                        <TextBox Grid.Column="10" Text="{Binding SubstatusFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="6,4" AutomationProperties.Name="Filter substate"/>
                        <TextBox Grid.Column="12" Text="{Binding CommentsFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="6,4" AutomationProperties.Name="Filter comments"/>
                    </Grid>
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding Selected}"
                             Style="{StaticResource DeskList}"
                             ItemContainerStyle="{StaticResource DeskListItem}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" MinWidth="64" SharedSizeGroup="HwSerial"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*" MinWidth="80"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwAssigned"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwLocation"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="90" MinWidth="64" SharedSizeGroup="HwState"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="110" MinWidth="72" SharedSizeGroup="HwSubstate"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="140" MinWidth="72" SharedSizeGroup="HwComments"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SerialNumber}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Model}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding AssignedTo.Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Location.Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="8" Text="{Binding InstallStatusLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="10" Text="{Binding SubstatusLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="12" Text="{Binding Comments}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <Border Style="{StaticResource Banner}" Background="{StaticResource ErrorSoftBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0"
                        Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorMessage}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" Visibility="{Binding EditorMessage, Converter={StaticResource StringVis}}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                            <Button Content="Discard" Style="{StaticResource SecondaryButton}" Command="{Binding DiscardCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="Select a serial number to open the asset." Margin="0,24,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolVis}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Serial number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SerialNumber, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ModelName, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Assigned to" Style="{StaticResource FieldLabel}"/>
                        <controls:ReferenceEditor DataContext="{Binding AssignedTo}" Margin="0,0,0,10"/>

                        <TextBlock Text="State" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding InstallStatuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding InstallStatus}" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowSubstate, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Substate" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Substatuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Substatus}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10" Visibility="{Binding StockroomRequired, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Stockroom" Style="{StaticResource FieldLabel}"/>
                            <controls:ReferenceEditor DataContext="{Binding Stockroom}"/>
                        </StackPanel>

                        <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                        <controls:ReferenceEditor DataContext="{Binding Location}" Margin="0,0,0,4"/>
                        <TextBlock Text="Required for In stock, Missing, and Retired." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Comments" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
