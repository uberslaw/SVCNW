<UserControl x:Class="ServiceNowDesk.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServiceNowDesk.Controls"
             xmlns:views="clr-namespace:ServiceNowDesk.Views">
    <UserControl.Resources>
        <Style x:Key="HardwareTabButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Banner}" Background="{StaticResource ErrorSoftBrush}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Hardware" Command="{Binding ShowHardwarePageCommand}" AutomationProperties.Name="Hardware tab">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource HardwareTabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowHardwareList}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Delivery" Command="{Binding ShowDeliveryPageCommand}" AutomationProperties.Name="Delivery">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource HardwareTabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDelivery}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Upgrades" Command="{Binding OpenLaptopRefreshCommand}" AutomationProperties.Name="Upgrades">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource HardwareTabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowUpgrades}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Grid Grid.Row="2">
        <Grid Visibility="{Binding ShowDelivery, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Delivery" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Choose one stockroom for the batch. Type a serial or let the scanner type it, then press Enter. That adds the exact text as a row and clears this box. Look up, press Enter on the row, or leave the field to match that text. Extra characters in front of 5C are only a hint." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Stockroom" Style="{StaticResource FieldLabel}"/>
                        <controls:ReferenceEditor DataContext="{Binding ReceiveStockroom}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Serial" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False"
                                 PreviewKeyDown="ScanBox_PreviewKeyDown"
                                 AutomationProperties.Name="Scan serial"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding ReceiveMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding ReceiveMessage, Converter={StaticResource StringVis}}"/>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12" MinHeight="280">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Scanned serials" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="Serials you scan or type appear in this list." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                               Visibility="{Binding HasBatch, Converter={StaticResource InverseBoolVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Batch}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="False"
                                                 LostFocus="RowSerial_LostFocus"
                                                 PreviewKeyDown="RowSerial_PreviewKeyDown"
                                                 AutomationProperties.Name="Scanned serial"/>
                                        <Button Grid.Column="2" Content="Look up" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.LookupRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Hint}" Foreground="{StaticResource CustomerBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasHint, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding MatchedSerial, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding OldState, Mode=OneWay}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding NewState, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding ShowHardwareList, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel HorizontalAlignment="Stretch">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid Margin="0,0,0,6" Visibility="{Binding RegionPickerOpen, Converter={StaticResource InverseBoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Region" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenRegionPickerCommand}"
                                Padding="12,4" MinHeight="28"
                                ToolTip="Choose the offices shown in this table"
                                AutomationProperties.Name="Region"/>
                        <TextBlock Grid.Column="1" Text="{Binding OfficeSelectionSummary}"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <StackPanel Visibility="{Binding RegionPickerOpen, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding AccountOfficeText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="Choose a region to show that hardware on this window only. It does not change the region in Settings. Clear override returns to your office. OK closes this list." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MaxHeight="280" Margin="0,0,0,6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <views:RegionSettingsView DataContext="{Binding RegionPicker}"
                                                          ShowIntro="False"
                                                          AutomationProperties.Name="Hardware region"/>
                            </ScrollViewer>
                        </Border>
                        <Button Content="OK" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Command="{Binding ConfirmRegionCommand}" Margin="0,0,0,6"
                                AutomationProperties.Name="OK region"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Clear override" Style="{StaticResource SecondaryButton}" Command="{Binding ClearOverrideCommand}" Margin="0,0,8,0"/>
                        <Button Content="Refresh this office" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshOfficeCatalogCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Refresh all" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAllCatalogCommand}"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"/>
                        <Button Content="Download region laptops" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DownloadRegionLaptopsCommand}" Margin="8,0,0,0"
                                IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                                ToolTip="CSV of model, configuration item, and assigned to for In use computers in the region. It uses the region on this page, or the offices saved in Settings."
                                AutomationProperties.Name="Download region laptops"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ExportNote}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding ExportNote, Converter={StaticResource StringVis}}"/>
                    <TextBlock Text="{Binding OfficeStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding OfficeStatus, Converter={StaticResource StringVis}}"/>
                    <TextBlock Text="{Binding CatalogStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding CatalogStatus, Converter={StaticResource StringVis}}"/>
                    <Grid Margin="0,0,0,6" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" Height="16"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                   Text="{Binding DownloadPercent, StringFormat={}{0}%}"/>
                    </Grid>
                </StackPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Text="{Binding ShownCount, StringFormat={}{0} shown}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="  Filtering…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                               Visibility="{Binding IsFiltering, Converter={StaticResource BoolVis}}"
                               AutomationProperties.Name="Hardware filtering status"/>
                    <TextBlock Text="  Loading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="  Downloading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"/>
                    <Grid Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="SearchTipsButton"
                                Content="Search tips"
                                Style="{StaticResource QuietButton}"
                                Padding="6,2"
                                MinHeight="24"
                                Command="{Binding ShowSearchTipsCommand}"
                                ToolTip="Wildcard and filter rules"
                                AutomationProperties.Name="Search tips"/>
                        <Popup IsOpen="{Binding SearchTipsOpen, Mode=TwoWay}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=SearchTipsButton}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    Padding="14"
                                    MaxWidth="420"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <TextBlock Text="{Binding SearchTipsTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding SearchTipsBody}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                    <Button Content="Close"
                                            Style="{StaticResource SecondaryButton}"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0"
                                            Command="{Binding CloseSearchTipsCommand}"
                                            AutomationProperties.Name="Close search tips"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
                <!--
                  Filters must live in the UserControl namescope. DataGridColumn.Header content is not in the
                  DataGrid visual/namescope tree, so RelativeSource AncestorType=DataGrid and ElementName
                  bindings to HardwareList both fail — typed text never reaches *Filter properties.
                -->
                <Grid>
                <ScrollViewer x:Name="HardwareTableScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Stretch"
                              Focusable="False">
                <DockPanel x:Name="HardwareTableContent" HorizontalAlignment="Stretch">
                <Grid x:Name="HardwareFilters" DockPanel.Dock="Top" Margin="1,0,1,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" MinWidth="90"/>
                        <ColumnDefinition Width="2.4*" MinWidth="160"/>
                        <ColumnDefinition Width="1.6*" MinWidth="120"/>
                        <ColumnDefinition Width="1.2*" MinWidth="130"/>
                        <ColumnDefinition Width="0.8*" MinWidth="80"/>
                        <ColumnDefinition Width="0.9*" MinWidth="90"/>
                        <ColumnDefinition Width="2*" MinWidth="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource DeskColumnFilter}" Margin="6,0,4,0"
                             Text="{Binding SerialFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter serial"/>
                    <controls:ChoiceFilterBox x:Name="ModelFilterBox" Grid.Column="1" Margin="2,0,4,0"
                                              CountText="{Binding ModelFilterCountText}"
                                              FilterName="Filter model"
                                              ClearName="Clear model filter"/>
                    <TextBox Grid.Column="2" Style="{StaticResource DeskColumnFilter}" Margin="2,0,4,0"
                             Text="{Binding AssignedFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter assigned to"/>
                    <controls:ChoiceFilterBox x:Name="LocationFilterBox" Grid.Column="3" Margin="2,0,4,0"
                                              ClosedCharacters="18"
                                              CountText="{Binding LocationFilterCountText}"
                                              FilterName="Filter location"
                                              ClearName="Clear location filter"/>
                    <controls:ChoiceFilterBox x:Name="StateFilterBox" Grid.Column="4" Margin="2,0,4,0"
                                              ClosedCharacters="18"
                                              CountText="{Binding StateFilterCountText}"
                                              FilterName="Filter state"
                                              ClearName="Clear state filter"/>
                    <controls:ChoiceFilterBox x:Name="SubstateFilterBox" Grid.Column="5" Margin="2,0,4,0"
                                              ClosedCharacters="18"
                                              CountText="{Binding SubstateFilterCountText}"
                                              FilterName="Filter substate"
                                              ClearName="Clear substate filter"/>
                    <TextBox Grid.Column="6" Style="{StaticResource DeskColumnFilter}" Margin="2,0,6,0"
                             Text="{Binding CommentsFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter comments"/>
                </Grid>
                <DataGrid x:Name="HardwareList"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Selected}"
                          Style="{StaticResource DeskDataGrid}"
                          ColumnHeaderStyle="{StaticResource DeskDataGridColumnHeader}"
                          CellStyle="{StaticResource DeskDataGridCell}"
                          RowStyle="{StaticResource DeskDataGridRow}"
                          ColumnHeaderHeight="28"
                          CanUserResizeColumns="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Hardware list">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="1.1*" MinWidth="90"
                                            SortMemberPath="SerialNumber"
                                            ElementStyle="{StaticResource DeskDataGridAccentText}"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="2.4*" MinWidth="160"
                                            SortMemberPath="Model"
                                            ElementStyle="{StaticResource DeskDataGridText}"/>
                        <DataGridTextColumn Header="Assigned to" Binding="{Binding AssignedTo.Display}" Width="1.6*" MinWidth="120"
                                            SortMemberPath="AssignedTo.Display"
                                            ElementStyle="{StaticResource DeskDataGridText}"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location.Display}" Width="1.2*" MinWidth="130"
                                            SortMemberPath="Location.Display"
                                            ElementStyle="{StaticResource DeskDataGridText}"/>
                        <DataGridTextColumn Header="State" Binding="{Binding InstallStatusLabel}" Width="0.8*" MinWidth="80"
                                            SortMemberPath="InstallStatusLabel"
                                            ElementStyle="{StaticResource DeskDataGridText}"/>
                        <DataGridTextColumn Header="Substate" Binding="{Binding SubstatusLabel}" Width="0.9*" MinWidth="90"
                                            SortMemberPath="SubstatusLabel"
                                            ElementStyle="{StaticResource DeskDataGridText}"/>
                        <DataGridTextColumn Header="Comments" Binding="{Binding Comments}" Width="2*" MinWidth="140"
                                            SortMemberPath="Comments"
                                            ElementStyle="{StaticResource DeskDataGridText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>

            <DockPanel Grid.Column="1" Width="380" Margin="16,0,0,0"
                       Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0"
                        Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorMessage}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" Visibility="{Binding EditorMessage, Converter={StaticResource StringVis}}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                            <Button Content="Discard" Style="{StaticResource SecondaryButton}" Command="{Binding DiscardCommand}" Margin="0,0,8,0"/>
                            <Button Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseEditorCommand}"
                                    AutomationProperties.Name="Close asset"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Serial number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SerialNumber, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ModelName, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Assigned to" Style="{StaticResource FieldLabel}"/>
                        <controls:ReferenceEditor DataContext="{Binding AssignedTo}" Margin="0,0,0,10"/>

                        <TextBlock Text="State" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding InstallStatuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding InstallStatus}" Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowSubstate, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Substate" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Substatuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Substatus}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10" Visibility="{Binding StockroomRequired, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Stockroom" Style="{StaticResource FieldLabel}"/>
                            <controls:ReferenceEditor DataContext="{Binding Stockroom}"/>
                        </StackPanel>

                        <TextBlock Text="Location" Style="{StaticResource FieldLabel}"/>
                        <controls:ReferenceEditor DataContext="{Binding Location}" Margin="0,0,0,4"/>
                        <TextBlock Text="Required for In stock, Missing, and Retired." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Comments" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowUpgrades, Converter={StaticResource BoolVis}}"
                      AutomationProperties.Name="Laptop refresh">
            <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                                   Text="Import the full device list, the upgrade list, or the available-devices export. The file is recognised from its columns. People still using a laptop from 4 years ago or earlier, oldest first, are who should be next. Laptops in stock under 3 years old are the ones in the box. Laptops in transit stay in transit until they are changed to in stock. A vacation student, leave, or any other reason goes in the comment. The region chosen on Hardware limits these lists."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Import list" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LaptopRefresh.ImportDueListCommand}" Margin="0,0,8,0"
                                    AutomationProperties.Name="Import list"/>
                            <Button Content="Export sheet" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LaptopRefresh.ExportSheetCommand}"
                                    AutomationProperties.Name="Export laptop refresh"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LaptopRefresh.Summary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LaptopRefresh.Status}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding LaptopRefresh.Status, Converter={StaticResource StringVis}}"/>

                        <TextBlock Text="{Binding LaptopRefresh.InBoxHeading}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="No laptops in the box for this region." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding LaptopRefresh.ShowEmptyInBox, Converter={StaticResource BoolVis}}"/>
                        <DataGrid ItemsSource="{Binding LaptopRefresh.InBox}"
                                  Style="{StaticResource DeskDataGrid}"
                                  ColumnHeaderStyle="{StaticResource DeskDataGridColumnHeader}"
                                  CellStyle="{StaticResource DeskDataGridCell}"
                                  RowStyle="{StaticResource DeskDataGridRow}"
                                  ColumnHeaderHeight="32"
                                  MaxHeight="160"
                                  Margin="0,0,0,12"
                                  HeadersVisibility="Column"
                                  AutomationProperties.Name="Laptops in the box"
                                  Visibility="{Binding LaptopRefresh.HasInBox, Converter={StaticResource BoolVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="2*" MinWidth="120"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="3*" MinWidth="160"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" MinWidth="120"/>
                                <DataGridTextColumn Header="Stockroom" Binding="{Binding Stockroom}" Width="2*" MinWidth="120"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="2*" MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding LaptopRefresh.InTransitHeading}" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Visibility="{Binding LaptopRefresh.HasInTransit, Converter={StaticResource BoolVis}}"/>
                        <DataGrid ItemsSource="{Binding LaptopRefresh.InTransit}"
                                  Style="{StaticResource DeskDataGrid}"
                                  ColumnHeaderStyle="{StaticResource DeskDataGridColumnHeader}"
                                  CellStyle="{StaticResource DeskDataGridCell}"
                                  RowStyle="{StaticResource DeskDataGridRow}"
                                  ColumnHeaderHeight="32"
                                  MaxHeight="160"
                                  Margin="0,0,0,12"
                                  HeadersVisibility="Column"
                                  AutomationProperties.Name="Laptops in transit"
                                  Visibility="{Binding LaptopRefresh.HasInTransit, Converter={StaticResource BoolVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="2*" MinWidth="120"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="3*" MinWidth="160"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" MinWidth="120"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="2*" MinWidth="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding LaptopRefresh.NextHeading}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"
                                   Text="Oldest first. Next matches how many available laptops are in this region. Completed rows are hidden. A comment is the reason, including a vacation student."/>
                        <TextBlock Text="Nobody is waiting in this region." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding LaptopRefresh.ShowEmptyNext, Converter={StaticResource BoolVis}}"/>
                        <DataGrid ItemsSource="{Binding LaptopRefresh.Next}"
                                  Style="{StaticResource DeskDataGrid}"
                                  ColumnHeaderStyle="{StaticResource DeskDataGridColumnHeader}"
                                  CellStyle="{StaticResource DeskDataGridCell}"
                                  RowStyle="{StaticResource DeskDataGridRow}"
                                  ColumnHeaderHeight="32"
                                  MaxHeight="560"
                                  Margin="0,0,0,12"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Who should be next"
                                  Visibility="{Binding LaptopRefresh.HasNext, Converter={StaticResource BoolVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Queue" Binding="{Binding QueueText}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Assigned to" Binding="{Binding AssignedTo}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="User name" Binding="{Binding UserName}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Model code" Binding="{Binding ListedModel}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Computer" Binding="{Binding Hostname}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Age" Binding="{Binding AgeText}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Delivered" Binding="{Binding DeliveredText}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="110" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Still has it" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding StillHasLaptop, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      AutomationProperties.Name="Still has the old laptop"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Check" Binding="{Binding CheckText}" Width="90" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="On hold" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding OnHold, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      AutomationProperties.Name="On hold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Status, UpdateSourceTrigger=LostFocus}"
                                                     BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                                     Padding="4,2" VerticalAlignment="Center"
                                                     AutomationProperties.Name="Upgrade status"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Comment" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=LostFocus}"
                                                     BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                                     Padding="4,2" VerticalAlignment="Center"
                                                     AutomationProperties.Name="Upgrade comment"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding LaptopRefresh.ReceivedHeading}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"
                                   Text="A serial that was in the box is now assigned in ServiceNow. Type why, the same way the Melbourne sheet uses Comments. The first hardware refresh only remembers what is in the box."/>
                        <TextBlock Text="Nobody has received a boxed laptop yet." Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding LaptopRefresh.ShowEmptyReceived, Converter={StaticResource BoolVis}}"/>
                        <DataGrid ItemsSource="{Binding LaptopRefresh.Received}"
                                  Style="{StaticResource DeskDataGrid}"
                                  ColumnHeaderStyle="{StaticResource DeskDataGridColumnHeader}"
                                  CellStyle="{StaticResource DeskDataGridCell}"
                                  RowStyle="{StaticResource DeskDataGridRow}"
                                  ColumnHeaderHeight="32"
                                  MaxHeight="220"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Who actually received a laptop"
                                  Visibility="{Binding LaptopRefresh.HasReceived, Converter={StaticResource BoolVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="200" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Assigned to" Binding="{Binding AssignedTo}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Was" Binding="{Binding PreviousState}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Old laptop" Binding="{Binding OldLaptop}" Width="220" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Seen" Binding="{Binding SeenText}" Width="140" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Reason" Width="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=LostFocus}"
                                                     BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                                     Padding="4,2" VerticalAlignment="Center"
                                                     AutomationProperties.Name="Reason they received it"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
