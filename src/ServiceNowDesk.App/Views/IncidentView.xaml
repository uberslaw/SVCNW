<UserControl x:Class="ServiceNowDesk.Views.IncidentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServiceNowDesk.Controls">
    <Grid Margin="16,12,16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <controls:PresetBar DockPanel.Dock="Top"/>
            <Button DockPanel.Dock="Top" Content="Create new" Style="{StaticResource PrimaryButton}" Command="{Binding NewRecordCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Templates" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource CardBrush}" MaxHeight="132" Margin="0,0,0,6" Visibility="{Binding HasTemplates, Converter={StaticResource BoolVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,1">
                                        <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource QuietButton}" Padding="6,2"
                                                Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Delete this template"/>
                                        <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="6,2"
                                                Command="{Binding DataContext.ApplyTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Start a new incident from this template">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        </Button>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="No templates yet. Save the open incident to reuse it." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasTemplates, Converter={StaticResource InverseBoolVis}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name for the current incident"/>
                    <Button Grid.Column="2" Content="Save current" Style="{StaticResource SecondaryButton}" Command="{Binding SaveTemplateCommand}" ToolTip="Save the open incident as a template on this PC"/>
                </Grid>
                <TextBlock Text="{Binding TemplateMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding TemplateMessage, Converter={StaticResource StringVis}}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding TotalCount, StringFormat={}{0} shown}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="  Loading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SearchHint}" Foreground="{StaticResource CustomerBrush}" Margin="0,0,0,6" Visibility="{Binding SearchHint, Converter={StaticResource StringVis}}"/>
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected}"
                     ItemTemplate="{StaticResource TicketRowTemplate}"
                     ItemContainerStyle="{StaticResource TicketListItem}"
                     Style="{StaticResource DeskList}"/>
        </DockPanel>

        <Grid Grid.Column="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolVis}}">
                <TextBlock Text="Select an incident, or create a new one." FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="The list stays here while you work. Search from the box above." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                <Button Content="Create new" Style="{StaticResource PrimaryButton}" Command="{Binding NewRecordCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>

            <DockPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
                <StackPanel DockPanel.Dock="Top">
                    <Border Style="{StaticResource Banner}" Background="{StaticResource ErrorSoftBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource QuietButton}" Command="{Binding DismissErrorCommand}"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Banner}" Background="{StaticResource WarningSoftBrush}" Visibility="{Binding ShowUnsavedBanner, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Unsaved changes. Save or discard before opening another incident." TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Banner}" Background="{StaticResource AccentSoftBrush}" Visibility="{Binding ShowResolvePanel, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Resolve incident" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ResolveChoiceLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ResolveChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ResolveCode}" Margin="0,0,0,8"/>
                                <TextBlock Text="Close notes" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ResolveNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Confirm resolve" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmResolveCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelResolveCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding EditorMessage}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" Visibility="{Binding EditorMessage, Converter={StaticResource StringVis}}"/>
                        <WrapPanel>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,8"/>
                            <Button Content="Discard" Style="{StaticResource SecondaryButton}" Command="{Binding DiscardCommand}" Margin="0,0,8,8"/>
                            <Button Content="Resolve" Style="{StaticResource SecondaryButton}" Command="{Binding BeginResolveCommand}" Margin="0,0,8,8"/>
                            <Button Content="Create new" Style="{StaticResource SecondaryButton}" Command="{Binding NewRecordCommand}" Margin="0,0,8,8"/>
                            <Button Content="Copy number" Style="{StaticResource SecondaryButton}" Command="{Binding CopyNumberCommand}" Margin="0,0,8,8"/>
                            <Button Content="Open in browser" Style="{StaticResource SecondaryButton}" Command="{Binding OpenInBrowserCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Content="Copy" Style="{StaticResource QuietButton}" Command="{Binding CopyNumberCommand}" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Copy the incident number"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StateLabel}" Margin="12,6,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PriorityLabel}" Margin="12,6,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="{Binding OpenedAt, StringFormat=Opened {0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>

                        <TextBlock Text="Short description" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Caller" Style="{StaticResource FieldLabel}"/>
                                <controls:ReferenceEditor DataContext="{Binding Caller}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Assignment group" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Assignment.Groups}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Assignment.GroupId}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Assigned to" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Assignment.Members}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Assignment.MemberId}"/>
                                <TextBlock Text="{Binding Assignment.MemberHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding Assignment.MemberHint, Converter={StaticResource StringVis}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="State" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding StateChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding State}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Impact" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ImpactChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Impact}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Urgency" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding UrgencyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Urgency}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Priority" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PriorityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Priority}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding CategoryChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Category}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Subcategory" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding SubcategoryChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Subcategory}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Contact type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ContactChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ContactType}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowHoldReason, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="On hold reason" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding HoldReasonChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding HoldReason}"/>
                        </StackPanel>

                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <TextBlock Text="Attachments" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding AttachmentNote}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding AttachmentNote, Converter={StaticResource StringVis}}"/>
                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding FileName}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,0,0,2"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Download and open this file"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Journal}" MaxHeight="200" Style="{StaticResource DeskList}" ItemContainerStyle="{StaticResource DeskListItem}" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding KindLabel}" FontWeight="SemiBold"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Author}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding CreatedDisplay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="Work note" GroupName="IncidentJournal" Margin="0,0,16,0"
                                         IsChecked="{Binding JournalKind, Converter={StaticResource EnumEq}, ConverterParameter=WorkNotes}"/>
                            <RadioButton Content="Customer comment" GroupName="IncidentJournal" Foreground="{StaticResource CustomerBrush}"
                                         IsChecked="{Binding JournalKind, Converter={StaticResource EnumEq}, ConverterParameter=Comments}"/>
                        </StackPanel>
                        <TextBlock Text="Visible to the caller." Foreground="{StaticResource CustomerBrush}" Margin="0,0,0,6" Visibility="{Binding JournalIsCustomerVisible, Converter={StaticResource BoolVis}}"/>
                        <TextBox Text="{Binding JournalText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,8"/>
                        <Button Content="Post note" Style="{StaticResource SecondaryButton}" Command="{Binding PostJournalCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
