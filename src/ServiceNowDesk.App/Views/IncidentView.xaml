<UserControl x:Class="ServiceNowDesk.Views.IncidentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServiceNowDesk.Controls">
    <Grid x:Name="Layout" Margin="16,12,16,12" SizeChanged="Layout_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <DockPanel x:Name="ListPane" Grid.Column="0">
            <controls:PresetBar DockPanel.Dock="Top"/>
            <Button DockPanel.Dock="Top" Content="Create new" Style="{StaticResource ChipButton}" Command="{Binding NewRecordCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Templates" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,6" Visibility="{Binding HasTemplates, Converter={StaticResource BoolVis}}">
                    <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource QuietButton}" Padding="8,4" Margin="8,0,0,0"
                            Command="{Binding DeleteTemplateCommand}"
                            CommandParameter="{Binding SelectedTemplate}" ToolTip="Delete the selected template"/>
                    <ComboBox ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate}"
                              ToolTip="Choose a template to start a new incident. Names are alphabetical.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <TextBlock Text="No templates yet. Save the open incident to reuse it." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding HasTemplates, Converter={StaticResource InverseBoolVis}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name for the current incident"/>
                    <Button Grid.Column="2" Content="Save current" Style="{StaticResource SecondaryButton}" Command="{Binding SaveTemplateCommand}" ToolTip="Save the open incident as a template on this PC"/>
                </Grid>
                <TextBlock Text="{Binding TemplateMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding TemplateMessage, Converter={StaticResource StringVis}}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="{Binding TotalCount, StringFormat={}{0} shown}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="  Loading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SearchHint}" Foreground="{StaticResource CustomerBrush}" Margin="0,0,0,6" Visibility="{Binding SearchHint, Converter={StaticResource StringVis}}"/>
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected}"
                     ItemTemplate="{StaticResource TicketRowTemplate}"
                     ItemContainerStyle="{StaticResource TicketListItem}"
                     Style="{StaticResource DeskList}"/>
        </DockPanel>

        <Grid Grid.Column="2" MinWidth="0">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasEditor, Converter={StaticResource InverseBoolVis}}">
                <TextBlock Text="Select an incident, or create a new one." FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="The list stays here while you work. Search from the box above." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                <Button Content="Create new" Style="{StaticResource ChipButton}" Command="{Binding NewRecordCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>

            <DockPanel Visibility="{Binding HasEditor, Converter={StaticResource BoolVis}}">
                <StackPanel DockPanel.Dock="Top">
                    <Border Style="{StaticResource Banner}" Background="{StaticResource ErrorSoftBrush}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource QuietButton}" Command="{Binding DismissErrorCommand}"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Banner}" Background="{StaticResource WarningSoftBrush}" Visibility="{Binding ShowUnsavedBanner, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Unsaved changes. Save or discard before opening another incident." TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Banner}" Background="{StaticResource AccentSoftBrush}" Visibility="{Binding ShowResolvePanel, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="Resolve incident" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ResolveChoiceLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ResolveChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ResolveCode}" Margin="0,0,0,8"/>
                                <TextBlock Text="Close notes" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ResolveNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Confirm resolve" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmResolveCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelResolveCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding EditorMessage}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" Visibility="{Binding EditorMessage, Converter={StaticResource StringVis}}"/>
                        <WrapPanel>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,8"/>
                            <Button Content="Discard" Style="{StaticResource SecondaryButton}" Command="{Binding DiscardCommand}" Margin="0,0,8,8"/>
                            <Button Content="Resolve" Style="{StaticResource SecondaryButton}" Command="{Binding BeginResolveCommand}" Margin="0,0,8,8"/>
                            <Button Content="Create new" Style="{StaticResource ChipButton}" Command="{Binding NewRecordCommand}" Margin="0,0,8,8"/>
                            <Button Content="Copy number" Style="{StaticResource SecondaryButton}" Command="{Binding CopyNumberCommand}" Margin="0,0,8,8"/>
                            <Button Content="Open in browser" Style="{StaticResource SecondaryButton}" Command="{Binding OpenInBrowserCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="EditorScroll"
                              MinWidth="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="EditorScroll_SizeChanged"
                              ScrollChanged="EditorScroll_ScrollChanged">
                    <StackPanel x:Name="EditorForm" HorizontalAlignment="Stretch">
                        <StackPanel.Resources>
                            <Style x:Key="IncidentLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </StackPanel.Resources>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OpenedAt, StringFormat=Opened {0}}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Content="Copy" Style="{StaticResource QuietButton}" Command="{Binding CopyNumberCommand}" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Copy the incident number"/>
                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2,12,2" VerticalAlignment="Center" Background="Transparent" TextWrapping="Wrap">
                                                <Hyperlink Click="OpenAttachment_Click" Foreground="#0000EE" TextDecorations="Underline" ToolTip="Open this attachment">
                                                    <Run Text="{Binding FileName}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AttachmentNote}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                           Visibility="{Binding AttachmentNote, Converter={StaticResource StringVis}}"/>
                                <TextBlock Text="{Binding StateLabel}" Margin="12,6,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PriorityLabel}" Margin="12,6,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            </WrapPanel>
                        </DockPanel>

                        <TextBlock Text="Short description" Style="{StaticResource IncidentLabel}"/>
                        <TextBox Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Caller" Style="{StaticResource IncidentLabel}"/>
                                <controls:ReferenceEditor DataContext="{Binding Caller}" Margin="0,0,0,10"/>

                                <TextBlock Text="Location" Style="{StaticResource IncidentLabel}"/>
                                <TextBox Text="{Binding LocationText, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <TextBlock Text="Category" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding CategoryChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Category}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <TextBlock Text="Subcategory" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding SubcategoryChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Subcategory}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <TextBlock Text="Service offering" Style="{StaticResource IncidentLabel}"/>
                                <controls:CachedChoiceBox DataContext="{Binding ServiceOffering}"/>
                                <TextBlock Text="Required once this incident has been created." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Configuration item" Style="{StaticResource IncidentLabel}"/>
                                <controls:CachedChoiceBox DataContext="{Binding ConfigurationItem}" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="Channel" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding ContactChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ContactType}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <TextBlock Text="State" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding StateChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding State}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowHoldReason, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="On hold reason" Style="{StaticResource IncidentLabel}"/>
                                    <ComboBox ItemsSource="{Binding HoldReasonChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding HoldReason}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                                    <TextBlock Text="Follow up" Style="{StaticResource IncidentLabel}"/>
                                    <controls:FollowUpBox Text="{Binding FollowUp, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <TextBlock Text="Impact" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding ImpactChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Impact}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <TextBlock Text="Urgency" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding UrgencyChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Urgency}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <TextBlock Text="Priority" Style="{StaticResource IncidentLabel}"/>
                                <TextBox Text="{Binding PriorityLabel, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" Background="{StaticResource AppBrush}" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Calculated by ServiceNow." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Assignment group" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding Assignment.Groups}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Assignment.GroupId}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                <TextBlock Text="Assigned to" Style="{StaticResource IncidentLabel}"/>
                                <ComboBox ItemsSource="{Binding Assignment.Members}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Assignment.MemberId}" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="{Binding Assignment.MemberHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding Assignment.MemberHint, Converter={StaticResource StringVis}}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description" Style="{StaticResource IncidentLabel}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JournalHistoryTemplate}" Focusable="False" IsTabStop="False"/>
                        <WrapPanel Margin="0,0,0,6">
                            <RadioButton Content="Work note" GroupName="IncidentJournal" Margin="0,0,16,0"
                                         IsChecked="{Binding JournalKind, Converter={StaticResource EnumEq}, ConverterParameter=WorkNotes}"/>
                            <RadioButton Content="Customer comment" GroupName="IncidentJournal" Foreground="{StaticResource CustomerBrush}"
                                         IsChecked="{Binding JournalKind, Converter={StaticResource EnumEq}, ConverterParameter=Comments}"/>
                        </WrapPanel>
                        <TextBlock Text="Visible to the caller." Foreground="{StaticResource CustomerBrush}" Margin="0,0,0,6" Visibility="{Binding JournalIsCustomerVisible, Converter={StaticResource BoolVis}}"/>
                        <TextBox Text="{Binding JournalText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,8"/>
                        <Button Content="Post note" Style="{StaticResource SecondaryButton}" Command="{Binding PostJournalCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
