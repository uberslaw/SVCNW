<Window x:Class="ServiceNowDesk.Views.BrowserSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to ServiceNow"
        Height="760"
        Width="1040"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Cancel_Click"/>
                <Button DockPanel.Dock="Right" Content="Use this sign-in" Style="{StaticResource PrimaryButton}" Click="UseSignIn_Click"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Sign in with your company account. This window closes when ServiceNow accepts the session."/>
            </DockPanel>
        </Border>
        <wv2:WebView2 x:Name="Browser"/>
    </DockPanel>
</Window>
