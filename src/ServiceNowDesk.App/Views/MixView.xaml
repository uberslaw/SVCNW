<UserControl x:Class="ServiceNowDesk.Views.MixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServiceNowDesk.Controls">
    <DockPanel Margin="16,12,0,12">
        <controls:PresetBar DockPanel.Dock="Top"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{Binding TotalCount, StringFormat={}{0} shown}" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="  Loading…" Margin="8,0,0,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding FilterSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"
                   Visibility="{Binding FilterSummary, Converter={StaticResource StringVis}}"
                   AutomationProperties.Name="Active list filters"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding LastEncodedQuery}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                   Visibility="{Binding LastEncodedQuery, Converter={StaticResource StringVis}}"
                   ToolTip="{Binding LastEncodedQuery}"
                   AutomationProperties.Name="Last encoded query"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}"/>
        <ListBox ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected}"
                 ItemContainerStyle="{StaticResource TicketListItem}"
                 Style="{StaticResource DeskList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="8" Padding="6,1" Background="#E7F0F4" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                <Border Margin="8,0,0,0" CornerRadius="8" Padding="6,1" Background="#EEF3F4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateLabel}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,4,8,0"/>
                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,8,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Badge}" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding When}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
