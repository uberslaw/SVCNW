<Window x:Class="ServiceNowDesk.Views.WorkEffortCalcLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Effort calculation log"
        Width="880"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButton}" MinWidth="88"
                    HorizontalAlignment="Right" Click="Copy_Click"
                    AutomationProperties.Name="Copy calculation log"/>
        </DockPanel>
        <TextBox x:Name="Body"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 MinHeight="0"
                 Padding="12,10"
                 FontFamily="Segoe UI"
                 FontSize="13"
                 Background="{StaticResource CardBrush}"
                 Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource LineBrush}"
                 BorderThickness="1"
                 AutomationProperties.Name="Calculation log text"/>
    </DockPanel>
</Window>
