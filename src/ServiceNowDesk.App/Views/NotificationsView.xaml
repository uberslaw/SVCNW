<UserControl x:Class="ServiceNowDesk.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="8">
            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Text="Click a colored portion to show that queue, then click a row to open the incident, request item, or walk-up. Green is Assigned to me. Amber is Group queue. Crimson is SLA breaching. Blue is On hold past follow-up. Violet is Updated by caller. Cyan is Returned with notes. A thin strip at the top center of the screen is the desktop widget. Rest the pointer on it to drop the bar, whether this window is open or minimized. The bar also drops on the jiggle interval. Frequency, sound, the watched group, and office locations are in Settings."/>
            <TextBlock Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding PollError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding PollError, Converter={StaticResource StringVis}}"/>

            <ItemsControl ItemsSource="{Binding Circles}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,8,8" Cursor="Hand" Padding="10,6"
                                Command="{Binding DataContext.SelectQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Kind}"
                                AutomationProperties.Name="{Binding StatusLabel}"
                                ToolTip="{Binding ToolTipText}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Kind, Converter={StaticResource AlertBrush}}"/>
                                            <ContentPresenter/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding StatusLabel}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SelectedStatus}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding SelectedStatus, Converter={StaticResource StringVis}}"/>

            <Grid Margin="10,0,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Number" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="2" Text="State" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="3" Text="Group" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="4" Text="Queue" Style="{StaticResource FieldLabel}"/>
            </Grid>
            <TextBlock Text="No open records in this queue." Foreground="{StaticResource MutedBrush}" Margin="10,0,0,12"
                       Visibility="{Binding HasDashboardRows, Converter={StaticResource InverseBoolVis}}"/>
            <ListBox ItemsSource="{Binding DashboardRows}"
                     Style="{StaticResource DeskList}"
                     ItemContainerStyle="{StaticResource DeskListItem}"
                     MaxHeight="360"
                     MouseLeftButtonUp="Rows_MouseLeftButtonUp"
                     PreviewKeyDown="Rows_PreviewKeyDown"
                     AutomationProperties.Name="Notification dashboard"
                     Visibility="{Binding HasDashboardRows, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding Group}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding QueueLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Click a row, or press Enter, to open it." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
