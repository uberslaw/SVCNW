<UserControl x:Class="ServiceNowDesk.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ServiceNowDesk.Converters">
    <UserControl.Resources>
        <DataTemplate x:Key="StandardAlertRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AssignedLine}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding AssignedLine, Converter={StaticResource StringVis}}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding Group}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding QueueLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SlaAlertRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding AssigneeLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Margin="8,0" Text="{Binding Group}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding QueueLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <conv:AlertRowTemplateSelector x:Key="AlertRowTemplate"
                                       StandardTemplate="{StaticResource StandardAlertRow}"
                                       SlaTemplate="{StaticResource SlaAlertRow}"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="8">
            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding PollError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding PollError, Converter={StaticResource StringVis}}"/>

            <ItemsControl ItemsSource="{Binding Circles}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,8,8" Cursor="Hand" Padding="10,6"
                                Command="{Binding DataContext.SelectQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Kind}"
                                AutomationProperties.Name="{Binding StatusLabel}"
                                ToolTipService.InitialShowDelay="400"
                                ToolTipService.Placement="Top">
                            <Button.ToolTip>
                                <ToolTip Placement="Top">
                                    <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                               Text="{Binding PlacementTarget.DataContext.Description, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse IsHitTestVisible="False">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsJiggleCause}" Value="True">
                                                                    <Setter Property="Fill" Value="#FFE08A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <Ellipse IsHitTestVisible="False">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{Binding Kind, Converter={StaticResource AlertBrush}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsJiggleCause}" Value="True">
                                                                    <Setter Property="Margin" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>
                                            <ContentPresenter/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding StatusLabel}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SelectedStatus}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding SelectedStatus, Converter={StaticResource StringVis}}"/>

            <Grid Margin="10,0,10,4" Visibility="{Binding ShowAssigneeColumn, Converter={StaticResource InverseBoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Number" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="2" Text="State" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="3" Text="Group" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="4" Text="Queue" Style="{StaticResource FieldLabel}"/>
            </Grid>
            <Grid Margin="10,0,10,4" Visibility="{Binding ShowAssigneeColumn, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Number" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="2" Text="State" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="3" Text="Assigned to" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="4" Text="Group" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="5" Text="Queue" Style="{StaticResource FieldLabel}"/>
            </Grid>
            <TextBlock Text="No open records in this queue." Foreground="{StaticResource MutedBrush}" Margin="10,0,0,12"
                       Visibility="{Binding HasDashboardRows, Converter={StaticResource InverseBoolVis}}"/>
            <ListBox ItemsSource="{Binding DashboardRows}"
                     Style="{StaticResource DeskList}"
                     ItemContainerStyle="{StaticResource TicketListItem}"
                     ItemTemplateSelector="{StaticResource AlertRowTemplate}"
                     MaxHeight="360"
                     MouseLeftButtonUp="Rows_MouseLeftButtonUp"
                     PreviewKeyDown="Rows_PreviewKeyDown"
                     AutomationProperties.Name="Notification dashboard"
                     Visibility="{Binding HasDashboardRows, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,8"/>

            <TextBlock Text="Click a row, or press Enter, to open it." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
