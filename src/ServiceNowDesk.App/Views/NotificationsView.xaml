<UserControl x:Class="ServiceNowDesk.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alerts="clr-namespace:ServiceNowDesk.Alerts;assembly=ServiceNowDesk.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="8">
            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Text="The bar at the top of the desk stays on screen while this window is open. Green is Assigned to me. Amber is the group queue. Click a colored portion to open that queue here. Click a row to open the incident, request item, or walk-up. While the desk is minimized, the same labeled circles stay fully on screen at the top."/>
            <TextBlock Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding PollError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding PollError, Converter={StaticResource StringVis}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton GroupName="NotificationQueue" Margin="0,0,8,0" Cursor="Hand" Padding="10,6"
                             Command="{Binding SelectQueueCommand}"
                             CommandParameter="{x:Static alerts:AlertKind.AssignedToMe}"
                             IsChecked="{Binding SelectedQueue, Converter={StaticResource EnumEq}, ConverterParameter=AssignedToMe, Mode=OneWay}"
                             Style="{StaticResource QueueChoice}"
                             AutomationProperties.Name="Assigned to me">
                    <TextBlock Text="{Binding Circles[0].StatusLabel}"/>
                </RadioButton>
                <RadioButton GroupName="NotificationQueue" Cursor="Hand" Padding="10,6"
                             Command="{Binding SelectQueueCommand}"
                             CommandParameter="{x:Static alerts:AlertKind.WatchedGroup}"
                             IsChecked="{Binding SelectedQueue, Converter={StaticResource EnumEq}, ConverterParameter=WatchedGroup, Mode=OneWay}"
                             Style="{StaticResource QueueChoice}"
                             AutomationProperties.Name="Group queue">
                    <TextBlock Text="{Binding Circles[1].StatusLabel}"/>
                </RadioButton>
            </StackPanel>

            <Grid Margin="10,0,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Number" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="2" Text="State" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="3" Text="Group" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Column="4" Text="Queue" Style="{StaticResource FieldLabel}"/>
            </Grid>
            <TextBlock Text="No open records in this queue." Foreground="{StaticResource MutedBrush}" Margin="10,0,0,12"
                       Visibility="{Binding HasDashboardRows, Converter={StaticResource InverseBoolVis}}"/>
            <ListBox ItemsSource="{Binding DashboardRows}"
                     Style="{StaticResource DeskList}"
                     ItemContainerStyle="{StaticResource DeskListItem}"
                     MaxHeight="360"
                     MouseLeftButtonUp="Rows_MouseLeftButtonUp"
                     PreviewKeyDown="Rows_PreviewKeyDown"
                     AutomationProperties.Name="Notification dashboard"
                     Visibility="{Binding HasDashboardRows, Converter={StaticResource BoolVis}}"
                     Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding Group}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding QueueLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Click a row, or press Enter, to open it." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Notification settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <TextBlock Text="Jiggle frequency (HH:MM:SS)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="Jiggle duration (seconds)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <CheckBox Content="Maximize when jiggling" IsChecked="{Binding MaximizeWhenJiggling}" Margin="0,0,0,8"/>
                    <CheckBox Content="Play sound when jiggling" IsChecked="{Binding PlaySoundWhenJiggling}" Margin="0,0,0,8"/>
                    <CheckBox Content="Play sound on alert metric" IsChecked="{Binding PlaySoundOnAlertMetric}" Margin="0,0,0,10"/>

                    <TextBlock Text="Sound (.wav)" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseSound_Click"/>
                        <TextBox Text="{Binding SoundPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" ToolTip="Leave this empty to use the Windows exclamation sound."/>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                               Text="Play sound when jiggling uses the repeating timer. Play sound on alert metric plays as soon as a number increases, even when the timer sound is off. Both use this file, or the Windows exclamation sound when no file is chosen."/>

                    <TextBlock Text="Watched group name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding GroupNameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="Office locations (one city per line)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding LocationsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,10"/>

                    <TextBlock Text="Check ServiceNow every (seconds)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding PollSecondsText, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                    <Button Content="Save notification settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}"/>
                    <TextBlock Text="{Binding SettingsMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding SettingsMessage, Converter={StaticResource StringVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
