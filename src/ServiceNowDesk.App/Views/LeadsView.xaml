<UserControl x:Class="ServiceNowDesk.Views.LeadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ServiceNowDesk.Views">
    <UserControl.Resources>
        <Style x:Key="EffortRow" TargetType="ListBoxItem" BasedOn="{StaticResource DeskListItem}">
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTicketPane}" Value="False">
                                <Setter Property="Height" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" MaxWidth="980" HorizontalAlignment="Left" Margin="8,8,8,0">
            <TextBlock Text="Leads" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton GroupName="LeadArea" Content="My team" Style="{StaticResource QueueChoice}"
                             Padding="14,8" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold"
                             IsChecked="{Binding Area, Converter={StaticResource EnumEq}, ConverterParameter=Team}"
                             AutomationProperties.Name="My team"/>
                <RadioButton GroupName="LeadArea" Content="Regional" Style="{StaticResource QueueChoice}"
                             Padding="14,8" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold"
                             IsChecked="{Binding Area, Converter={StaticResource EnumEq}, ConverterParameter=Regional}"
                             AutomationProperties.Name="Regional"/>
                <RadioButton GroupName="LeadArea" Content="Work Effort" Style="{StaticResource QueueChoice}"
                             Padding="14,8" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold"
                             IsChecked="{Binding Area, Converter={StaticResource EnumEq}, ConverterParameter=WorkEffort}"
                             AutomationProperties.Name="Work Effort"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12">
                <TextBlock.Text>
                    <Binding Path="GroupName" StringFormat="My team and Regional use the same work queues as Notifications: SLA breaching, on hold past follow-up, updated by caller, Returned by DT, and unattended tickets. My team is the people you tick from {0}. Regional is every open ticket in that group. Save team stores the ticked names on this PC and hides the checkboxes. Edit team brings the ticks back. Click a row to open it. A light green SLA row is assigned to you. Daily Work uses the same ticked names for the team report. Work Effort counts only the people on the team."/>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="8,0,8,8">
            <StackPanel Visibility="{Binding ShowQueues, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding RosterNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding RosterNote, Converter={StaticResource StringVis}}"/>
                <TextBlock Text="{Binding LockedTeamNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding ShowLockedTeam, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding LockedNames}" Margin="0,0,0,8"
                              Visibility="{Binding ShowLockedTeam, Converter={StaticResource BoolVis}}"
                              AutomationProperties.Name="Locked team">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,0,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding TeamSavedNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding ShowSavedNames, Converter={StaticResource BoolVis}}"/>
                <ItemsControl ItemsSource="{Binding SavedNames}" Margin="0,0,0,8"
                              Visibility="{Binding ShowSavedNames, Converter={StaticResource BoolVis}}"
                              AutomationProperties.Name="Saved team">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,0,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Members}" Margin="0,0,0,8"
                              Visibility="{Binding ShowCheckboxes, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,16,8"
                                      AutomationProperties.Name="{Binding Name, StringFormat=Team {0}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Save team" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding SaveTeamCommand}"
                            Visibility="{Binding ShowSaveTeam, Converter={StaticResource BoolVis}}"
                            AutomationProperties.Name="Save team"/>
                    <Button Content="Edit team" Style="{StaticResource SecondaryButton}"
                            Command="{Binding EditTeamCommand}"
                            Visibility="{Binding ShowEditTeam, Converter={StaticResource BoolVis}}"
                            AutomationProperties.Name="Edit team"/>
                </StackPanel>
                <TextBlock Text="{Binding TeamPrompt}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                           Visibility="{Binding TeamPrompt, Converter={StaticResource StringVis}}"/>

                <ItemsControl ItemsSource="{Binding Board.Circles}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,8" Cursor="Hand" Padding="10,6"
                                    Command="{Binding DataContext.Board.SelectQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Kind}"
                                    AutomationProperties.Name="{Binding StatusLabel}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Kind, Converter={StaticResource AlertBrush}}"/>
                                                <ContentPresenter/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding StatusLabel}"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Board.SelectedStatus}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="{Binding Board.SelectedStatus, Converter={StaticResource StringVis}}"/>

                <Grid Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding Board.NumberHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding Board.SortByCommand}" CommandParameter="Number" AutomationProperties.Name="Sort by number"/>
                    <Button Grid.Column="1" Content="{Binding Board.TitleHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding Board.SortByCommand}" CommandParameter="Title" AutomationProperties.Name="Sort by title"/>
                    <Button Grid.Column="2" Content="{Binding Board.StateHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding Board.SortByCommand}" CommandParameter="State" AutomationProperties.Name="Sort by state"/>
                    <Button Grid.Column="3" Content="{Binding Board.AssigneeHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding Board.SortByCommand}" CommandParameter="Assignee" AutomationProperties.Name="Sort by assigned to"/>
                    <Button Grid.Column="4" Content="{Binding Board.GroupHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding Board.SortByCommand}" CommandParameter="Group" AutomationProperties.Name="Sort by group"/>
                    <Button Grid.Column="5" Content="{Binding Board.QueueHeader}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Command="{Binding Board.SortByCommand}" CommandParameter="Queue" AutomationProperties.Name="Sort by queue"/>
                </Grid>
                <TextBlock Text="No open records in this queue." Foreground="{StaticResource MutedBrush}" Margin="10,0,0,12"
                           Visibility="{Binding Board.HasDashboardRows, Converter={StaticResource InverseBoolVis}}"/>
                <ListBox ItemsSource="{Binding Board.DashboardRows}"
                         Style="{StaticResource DeskList}"
                         ItemContainerStyle="{StaticResource TicketListItem}"
                         MaxHeight="360"
                         MouseLeftButtonUp="Rows_MouseLeftButtonUp"
                         PreviewKeyDown="Rows_PreviewKeyDown"
                         AutomationProperties.Name="Lead dashboard"
                         Visibility="{Binding Board.HasDashboardRows, Converter={StaticResource BoolVis}}"
                         Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding State}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding AssigneeLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Margin="8,0" Text="{Binding Group}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding QueueLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding Board.LastChecked}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowWorkEffort, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Work Effort" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding LockedTeamNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding LockedTeamNote, Converter={StaticResource StringVis}}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                           Text="Only the people you tick on My team, once each. IMS is a walk-up. Open or resolve: incident 1, request item 0.7, walk-up 0.6. Daily updates is on when this panel opens: one update credit (0.3) per person, per ticket, per local day. Allow multiple updates counts each save. An open, resolve, or close is not also an update on that same day. A later day still counts. Closing counts as the resolve when that person did not also resolve it. If nobody is ticked, define the team before a report runs. A long report stays on a background task and shows how many minutes are left. Figures load the first time you open a time scale each day. The update switch uses that loaded history and does not ask ServiceNow again. Refresh reloads the scale you are looking at. Leaving this page does not stop the load. After figures load, click a name for every ticket that person was credited, or a count cell for that metric alone. Export writes a CSV for the open detail or the full board."/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WorkEffort.AsOf}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding WorkEffort.AsOf, Converter={StaticResource StringVis}}"/>
                    <Button Grid.Column="1" Content="Export board" Style="{StaticResource SecondaryButton}" MinWidth="104" Margin="0,0,8,0"
                            Command="{Binding WorkEffort.ExportBoardCommand}"
                            IsEnabled="{Binding WorkEffort.HasRows}"
                            AutomationProperties.Name="Export work effort board"/>
                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource SecondaryButton}" MinWidth="88"
                            Command="{Binding WorkEffort.RefreshCommand}"
                            AutomationProperties.Name="Refresh work effort"/>
                </Grid>
                <WrapPanel Margin="0,0,0,12" AutomationProperties.Name="Work Effort time scale">
                    <RadioButton GroupName="WorkEffortScale" Content="Today" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.Scale, Converter={StaticResource EnumEq}, ConverterParameter=Today}"
                                 AutomationProperties.Name="Today"/>
                    <RadioButton GroupName="WorkEffortScale" Content="This week" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.Scale, Converter={StaticResource EnumEq}, ConverterParameter=ThisWeek}"
                                 AutomationProperties.Name="This week"/>
                    <RadioButton GroupName="WorkEffortScale" Content="This month" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.Scale, Converter={StaticResource EnumEq}, ConverterParameter=ThisMonth}"
                                 AutomationProperties.Name="This month"/>
                    <RadioButton GroupName="WorkEffortScale" Content="Last 4 weeks" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.Scale, Converter={StaticResource EnumEq}, ConverterParameter=Last4Weeks}"
                                 AutomationProperties.Name="Last 4 weeks"/>
                    <RadioButton GroupName="WorkEffortScale" Content="6 months" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.Scale, Converter={StaticResource EnumEq}, ConverterParameter=SixMonths}"
                                 AutomationProperties.Name="6 months"/>
                    <RadioButton GroupName="WorkEffortScale" Content="12 months" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.Scale, Converter={StaticResource EnumEq}, ConverterParameter=TwelveMonths}"
                                 AutomationProperties.Name="12 months"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8" AutomationProperties.Name="Work Effort update counting">
                    <RadioButton GroupName="WorkEffortUpdates" Content="Daily updates" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.UpdateMode, Converter={StaticResource EnumEq}, ConverterParameter=Daily}"
                                 AutomationProperties.Name="Daily updates"/>
                    <RadioButton GroupName="WorkEffortUpdates" Content="Allow multiple updates" Margin="0,0,16,8"
                                 IsChecked="{Binding WorkEffort.UpdateMode, Converter={StaticResource EnumEq}, ConverterParameter=Multiple}"
                                 AutomationProperties.Name="Allow multiple updates"/>
                </WrapPanel>
                <ProgressBar Minimum="0"
                             Maximum="{Binding WorkEffort.ProgressMaximum}"
                             Value="{Binding WorkEffort.ProgressValue}"
                             Height="10"
                             Margin="0,0,0,8"
                             Background="{StaticResource DownloadTrackBrush}"
                             Foreground="{StaticResource DownloadFillBrush}"
                             BorderThickness="0"
                             IsHitTestVisible="False"
                             Visibility="{Binding WorkEffort.IsLoading, Converter={StaticResource BoolVis}}"
                             AutomationProperties.Name="Work Effort progress">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock Text="{Binding WorkEffort.Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding WorkEffort.Status, Converter={StaticResource StringVis}}"/>
                <TextBlock Text="{Binding WorkEffort.Shift}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding WorkEffort.Shift, Converter={StaticResource StringVis}}"
                           AutomationProperties.Name="Work Effort update shift"/>
                <TextBlock Text="{Binding WorkEffort.EmptyMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                           Visibility="{Binding WorkEffort.EmptyMessage, Converter={StaticResource StringVis}}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding WorkEffort.HasRows, Converter={StaticResource BoolVis}}">
                    <StackPanel MinWidth="1040">
                        <Grid Margin="10,0,10,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="INC opened" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="INC resolved" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="INC updated" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="RITM opened" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="RITM resolved" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="RITM updated" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="IMS opened" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="8" Text="IMS resolved" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="9" Text="IMS updated" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" TextAlignment="Right"/>
                            <TextBlock Grid.Column="10" Text="Total" Style="{StaticResource FieldLabel}" TextAlignment="Right"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding WorkEffort.Rows}"
                                 Style="{StaticResource DeskList}"
                                 ItemContainerStyle="{StaticResource EffortRow}"
                                 AutomationProperties.Name="Work Effort"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Cursor="Hand" MouseLeftButtonUp="EffortName_MouseLeftButtonUp"
                                                   ToolTip="Show every ticket credited to this person"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IncOpened}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="IncOpened" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="2" Text="{Binding IncResolved}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="IncResolved" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IncUpdated}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="IncUpdated" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="4" Text="{Binding RitmOpened}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="RitmOpened" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="5" Text="{Binding RitmResolved}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="RitmResolved" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="6" Text="{Binding RitmUpdated}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="RitmUpdated" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="7" Text="{Binding ImsOpened}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="ImsOpened" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="8" Text="{Binding ImsResolved}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="ImsResolved" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="9" Text="{Binding ImsUpdated}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" Tag="ImsUpdated" MouseLeftButtonUp="EffortCell_MouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="10" Text="{Binding WeightedText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{Binding WorkEffort.ExportNote}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                           Visibility="{Binding WorkEffort.ExportNote, Converter={StaticResource StringVis}}"/>
                <Border Margin="0,16,0,0" Padding="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        Visibility="{Binding WorkEffort.ShowDetail, Converter={StaticResource BoolVis}}"
                        AutomationProperties.Name="Work Effort detail">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding WorkEffort.DetailTitle}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="Export" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="8,0,8,0"
                                    Command="{Binding WorkEffort.ExportDetailCommand}"
                                    AutomationProperties.Name="Export work effort detail"/>
                            <Button Grid.Column="2" Content="Close" Style="{StaticResource QuietButton}" MinWidth="72"
                                    Command="{Binding WorkEffort.CloseDetailCommand}"
                                    AutomationProperties.Name="Close work effort detail"/>
                        </Grid>
                        <TextBlock Text="{Binding WorkEffort.DetailEmptyMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding WorkEffort.DetailEmptyMessage, Converter={StaticResource StringVis}}"/>
                        <Grid Margin="0,0,0,4" Visibility="{Binding WorkEffort.DetailHasRows, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Number" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="2" Text="Table" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="3" Text="Metric" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="4" Text="When" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="5" Text="Person" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="6" Text="Day" Style="{StaticResource FieldLabel}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding WorkEffort.DetailLines}"
                                 Style="{StaticResource DeskList}"
                                 MaxHeight="280"
                                 Visibility="{Binding WorkEffort.DetailHasRows, Converter={StaticResource BoolVis}}"
                                 AutomationProperties.Name="Work Effort detail lines"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayNumber}" Foreground="{StaticResource AccentBrush}" Cursor="Hand"
                                                   MouseLeftButtonUp="EffortCreditNumber_MouseLeftButtonUp" TextTrimming="CharacterEllipsis"
                                                   ToolTip="Open this ticket"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TableLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MetricLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding WhenText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PersonName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Day}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="8,0,8,8" Padding="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="160">
                    <TextBlock Text="{Binding EditorPrompt}" Foreground="{StaticResource MutedBrush}" Margin="8"
                               Visibility="{Binding EditorPrompt, Converter={StaticResource StringVis}}"/>
                    <StackPanel Margin="8" Visibility="{Binding ShowUnknownEditor, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding UnknownNumber}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding UnknownTitle}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <Button Content="Open in browser" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Command="{Binding OpenUnknownInBrowserCommand}" AutomationProperties.Name="Open in browser"/>
                    </StackPanel>
                    <!-- Visibility on the wrapper; DataContext on the child. Same-element bindings resolve Show* against the page VM and every editor stays Visible. -->
                    <Grid Visibility="{Binding ShowIncidentEditor, Converter={StaticResource BoolVis}}">
                        <local:IncidentView DataContext="{Binding IncidentEditor}" EditorOnly="True"/>
                    </Grid>
                    <Grid Visibility="{Binding ShowRequestEditor, Converter={StaticResource BoolVis}}">
                        <local:RequestView DataContext="{Binding RequestEditor}" EditorOnly="True"/>
                    </Grid>
                    <Grid Visibility="{Binding ShowRequestedItemEditor, Converter={StaticResource BoolVis}}">
                        <local:RequestedItemView DataContext="{Binding RequestedItemEditor}" EditorOnly="True"/>
                    </Grid>
                    <Grid Visibility="{Binding ShowWalkUpEditor, Converter={StaticResource BoolVis}}">
                        <local:InteractionView DataContext="{Binding WalkUpEditor}" EditorOnly="True"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
