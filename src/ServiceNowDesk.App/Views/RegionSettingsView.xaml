<UserControl x:Class="ServiceNowDesk.Views.RegionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
        <StackPanel DataContext="{Binding Region}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                       Text="Offices in your region. Hardware → Region shows computers whose location matches the offices you tick. A region or group tick selects every office under it. The choice is saved on this PC."/>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8,0,4">
                            <CheckBox Content="{Binding Label}"
                                      FontWeight="SemiBold"
                                      IsThreeState="True"
                                      IsChecked="{Binding IsChecked, Mode=OneWay}"
                                      PreviewMouseLeftButtonDown="GroupCheck_PreviewMouseLeftButtonDown"
                                      PreviewKeyDown="GroupCheck_PreviewKeyDown"
                                      AutomationProperties.Name="{Binding Label, StringFormat=Region {0}}"/>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="18,4,0,0"
                                          Visibility="{Binding ChildrenAreOffices, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsChecked}"
                                                  Margin="0,2,16,2"
                                                  AutomationProperties.Name="{Binding Label, StringFormat=Office {0}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="18,2,0,0"
                                          Visibility="{Binding ChildrenAreOffices, Converter={StaticResource InverseBoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,2">
                                            <CheckBox Content="{Binding Label}"
                                                      FontWeight="SemiBold"
                                                      IsThreeState="True"
                                                      IsChecked="{Binding IsChecked, Mode=OneWay}"
                                                      PreviewMouseLeftButtonDown="GroupCheck_PreviewMouseLeftButtonDown"
                                                      PreviewKeyDown="GroupCheck_PreviewKeyDown"
                                                      AutomationProperties.Name="{Binding Label, StringFormat=Region {0}}"/>
                                            <ItemsControl ItemsSource="{Binding Children}" Margin="18,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding IsChecked}"
                                                                  Margin="0,2,16,2"
                                                                  AutomationProperties.Name="{Binding Label, StringFormat=Office {0}}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
