<Window x:Class="ServiceNowDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ServiceNowDesk.Views"
        Title="{Binding WindowTitle}"
        Height="800"
        Width="1280"
        MinHeight="640"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico"
        Background="{StaticResource AppBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding Startup.ShowBar, Converter={StaticResource BoolVis}}"
                AutomationProperties.Name="Download progress">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="14"
                           Text="{Binding Startup.PercentText}"/>
                <TextBlock Text="{Binding Startup.CountText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                AutomationProperties.Name="Notifications">
            <StackPanel>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notifications.WidgetHasUnread}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Command="{Binding Notifications.ToggleWidgetCommand}"
                                Cursor="Hand" Margin="8,6,12,6" Padding="8,4"
                                AutomationProperties.Name="Open or close notifications"
                                Style="{StaticResource QuietButton}">
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="Open"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Notifications.IsWidgetOpen}" Value="True">
                                                <Setter Property="Text" Value="Close"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Notifications.Circles}" Focusable="False" VerticalAlignment="Center" Margin="12,0,4,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.Notifications.SelectQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Kind}"
                                            Cursor="Hand"
                                            Focusable="False"
                                            Margin="0,6,8,6"
                                            Padding="8,4"
                                            AutomationProperties.Name="{Binding StatusLabel}"
                                            ToolTip="{Binding ToolTipText}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="22" Height="22" Margin="0,0,6,0">
                                                            <Ellipse Fill="{Binding Kind, Converter={StaticResource AlertBrush}}"/>
                                                            <TextBlock Text="{Binding Count}" Foreground="White" FontWeight="Bold" FontSize="11"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding StatusLabel}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Command="{Binding Notifications.ToggleWidgetCommand}"
                                Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,8"
                                AutomationProperties.Name="Notification summary">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentBrush}" Text="&#xEA8F;"/>
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" Text="Notifications"/>
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" Text="{Binding Notifications.WidgetSummary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Notifications.WidgetHasUnread}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding Notifications.NewestTitle}"
                                           Visibility="{Binding Notifications.NewestTitle, Converter={StaticResource StringVis}}"/>
                            </DockPanel>
                        </Button>
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding Notifications.IsWidgetOpen, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="16,8" Foreground="{StaticResource MutedBrush}" Text="No notifications"
                                   Visibility="{Binding Notifications.HasWidgetItems, Converter={StaticResource InverseBoolVis}}"/>
                        <ListBox x:Name="NotificationWidgetList"
                                 ItemsSource="{Binding Notifications.WidgetItems}"
                                 Style="{StaticResource DeskList}"
                                 ItemContainerStyle="{StaticResource DeskListItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="240"
                                 MouseDoubleClick="NotificationWidgetList_MouseDoubleClick"
                                 PreviewKeyDown="NotificationWidgetList_PreviewKeyDown"
                                 AutomationProperties.Name="Notification list"
                                 Visibility="{Binding Notifications.HasWidgetItems, Converter={StaticResource BoolVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Updated}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="Help" Padding="12,6">
                    <MenuItem Header="Documentation" Padding="12,8" Click="Documentation_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <Border Grid.Row="3" Grid.RowSpan="2" Background="{StaticResource NavBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,18,16,12">
                    <TextBlock Text="ServiceNow" Foreground="{StaticResource NavMutedBrush}" FontSize="12"/>
                    <TextBlock Text="Desk" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="20,8,16,16" Foreground="{StaticResource NavMutedBrush}" FontSize="11" TextWrapping="Wrap"
                           Text="Ctrl+K search&#10;Ctrl+N new&#10;Ctrl+S save&#10;Ctrl+Enter post note&#10;Ctrl+Shift+R resolve&#10;Ctrl+8 walk-up&#10;Ctrl+9 notifications&#10;F5 refresh"/>
                <StackPanel Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Incidents" Tag="&#xE7BA;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Incidents}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Requests" Tag="&#xE7BF;" Visibility="Collapsed" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Requests}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Request items" Tag="&#xE8FD;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=RequestedItems}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Walk-up" Tag="&#xE716;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=WalkUps}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Search" Tag="&#xE721;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Search}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Knowledge" Tag="&#xE82D;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Knowledge}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Notifications" Tag="&#xEA8F;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Notifications}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Order catalog" Tag="&#xE719;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Catalog}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="&#xE713;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Settings}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Connection" Tag="&#xE774;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Connection}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" MinWidth="72"
                            VerticalAlignment="Center" Command="{Binding BackCommand}"
                            Visibility="{Binding ShowBack, Converter={StaticResource BoolVis}}"
                            AutomationProperties.Name="Back"/>
                    <Grid Grid.Column="1" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" MinHeight="36" FontSize="14"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown"
                                 AutomationProperties.Name="Search"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#90A0A6"
                                   Text="{Binding SearchPlaceholder}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringVis}}"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Working…" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding ConnectedUser}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding InstanceLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource ErrorSoftBrush}" Padding="16,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource QuietButton}" Command="{Binding DismissMainErrorCommand}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid>
                <!-- Visibility stays on the wrapper. A DataContext on the same element would resolve SelectedSection against the page, and every page would stay visible. -->
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Incidents}">
                    <views:IncidentView DataContext="{Binding Incidents}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Requests}">
                    <views:RequestView DataContext="{Binding Requests}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=RequestedItems}">
                    <views:RequestedItemView DataContext="{Binding RequestedItems}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=WalkUps}">
                    <views:InteractionView DataContext="{Binding WalkUps}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Search}">
                    <views:SearchView DataContext="{Binding Search}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Knowledge}">
                    <views:KnowledgeView DataContext="{Binding Knowledge}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Notifications}">
                    <views:NotificationsView DataContext="{Binding Notifications}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Catalog}">
                    <views:CatalogView DataContext="{Binding Catalog}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Connection}">
                    <views:ConnectionView DataContext="{Binding}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Settings}">
                    <views:SettingsView DataContext="{Binding}"/>
                </Grid>
            </Grid>
        </DockPanel>

        <Border Grid.Column="1" Grid.Row="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"/>
        </Border>
        </Grid>

        <Border Background="#C0101718" Visibility="{Binding Startup.ShowScreen, Converter={StaticResource BoolVis}}">
            <Border Width="680" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#102226" Padding="20" CornerRadius="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Close" Margin="16,0,0,0" Padding="14,6" Cursor="Hand"
                                Command="{Binding CloseStartupCommand}" AutomationProperties.Name="Close download"
                                Foreground="#C9E6E1" Background="Transparent" BorderBrush="#1F6E6B" BorderThickness="1"/>
                        <TextBlock Text="{Binding Startup.Title}" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="#E7F6F3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" Foreground="#8FB8B2" TextWrapping="Wrap"
                               Text="Closing this does not stop the download. The desk stays available, with a short progress bar until every section finishes."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Startup.Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="13" Foreground="#C9E6E1" TextWrapping="Wrap" Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
