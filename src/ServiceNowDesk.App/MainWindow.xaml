<Window x:Class="ServiceNowDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ServiceNowDesk.Views"
        Title="{Binding WindowTitle}"
        Height="920"
        Width="1440"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{StaticResource TextBrush}">
                <MenuItem Header="Help" Padding="12,6">
                    <MenuItem Header="Documentation" Padding="12,8" Click="Documentation_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <Button Grid.Row="0" Grid.ColumnSpan="2"
                Command="{Binding ToggleDownloadLogCommand}"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Download progress"
                ToolTip="Show or hide the download log"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bar" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                       Text="Hide log" Visibility="{Binding Startup.IsOpen, Converter={StaticResource BoolVis}}"/>
                            <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                       Text="Show log" Visibility="{Binding Startup.IsOpen, Converter={StaticResource InverseBoolVis}}"/>
                            <TextBlock Text="{Binding Startup.Title}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#D3EBE7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#102226" BorderBrush="#1F6E6B" BorderThickness="0,0,0,1" Padding="16,8,16,12" MaxHeight="240"
                Visibility="{Binding Startup.IsOpen, Converter={StaticResource BoolVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Startup.Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="13" Foreground="#C9E6E1" TextWrapping="Wrap" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Grid.RowSpan="2" Background="{StaticResource NavBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,18,16,12">
                    <TextBlock Text="ServiceNow" Foreground="{StaticResource NavMutedBrush}" FontSize="12"/>
                    <TextBlock Text="Desk" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="20,8,16,16" Foreground="{StaticResource NavMutedBrush}" FontSize="11" TextWrapping="Wrap"
                           Text="Ctrl+K search&#10;Ctrl+N new&#10;Ctrl+S save&#10;Ctrl+Enter post note&#10;Ctrl+Shift+R resolve&#10;Ctrl+8 walk-up&#10;Ctrl+9 notifications&#10;F5 refresh"/>
                <StackPanel Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Incidents" Tag="&#xE7BA;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Incidents}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Requests" Tag="&#xE7BF;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Requests}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Request items" Tag="&#xE8FD;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=RequestedItems}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Walk-up" Tag="&#xE716;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=WalkUps}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Search" Tag="&#xE721;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Search}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Knowledge" Tag="&#xE82D;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Knowledge}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Notifications" Tag="&#xEA8F;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Notifications}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Order catalog" Tag="&#xE719;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Catalog}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Connection" Tag="&#xE713;" IsChecked="{Binding SelectedSection, Converter={StaticResource EnumEq}, ConverterParameter=Connection}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Back" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" MinWidth="72"
                            VerticalAlignment="Center" Command="{Binding BackCommand}"
                            Visibility="{Binding ShowBack, Converter={StaticResource BoolVis}}"
                            AutomationProperties.Name="Back"/>
                    <Grid Grid.Column="1" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" MinHeight="36" FontSize="14"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown"
                                 AutomationProperties.Name="Search"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#90A0A6"
                                   Text="{Binding SearchPlaceholder}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringVis}}"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Working…" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding ConnectedUser}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding InstanceLabel}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource ErrorSoftBrush}" Padding="16,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource QuietButton}" Command="{Binding DismissMainErrorCommand}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid>
                <!-- Visibility stays on the wrapper. A DataContext on the same element would resolve SelectedSection against the page, and every page would stay visible. -->
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Incidents}">
                    <views:IncidentView DataContext="{Binding Incidents}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Requests}">
                    <views:RequestView DataContext="{Binding Requests}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=RequestedItems}">
                    <views:RequestedItemView DataContext="{Binding RequestedItems}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=WalkUps}">
                    <views:InteractionView DataContext="{Binding WalkUps}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Search}">
                    <views:SearchView DataContext="{Binding Search}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Knowledge}">
                    <views:KnowledgeView DataContext="{Binding Knowledge}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Notifications}">
                    <views:NotificationsView DataContext="{Binding Notifications}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Catalog}">
                    <views:CatalogView DataContext="{Binding Catalog}"/>
                </Grid>
                <Grid Background="{StaticResource AppBrush}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Connection}">
                    <views:ConnectionView DataContext="{Binding}"/>
                </Grid>
            </Grid>
        </DockPanel>

        <Border Grid.Column="1" Grid.Row="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</Window>
